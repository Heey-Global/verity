  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@verity/events": "*",
    "kysely": "0.29.5",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@types/pg": "8.23.1"
  }
}
