{
  "name": "verity",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "description": "Open-core, self-hosted mobile control plane for steering coding agents across a development fleet",
  "engines": {
    "node": "^26.12.1",
    "npm": ">=11.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@expo/cli": {
      "zod": "$zod"
    },
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode@3.0.1": {
      "uuid": "14.0.3"
    },
    "expo-router": {
      "query-string": "$query-string"
    },
    "@bacons/xcode": {
      "uuid": "14.0.3",
      "@expo/plist": {
        "@xmldom/xmldom": "0.8.15"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:runner-worker": "npm run build && node scripts/build-runner-worker.mjs",
    "check:runner-worker": "npm run build && node scripts/build-runner-worker.mjs --check",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "bash scripts/lint.sh",
    "licenses:check": "node scripts/third-party-notices.ts --check",
    "licenses:write": "node scripts/third-party-notices.ts --write",
    "knip": "knip --exports",
    "lint:changed": "node scripts/lint-files.mjs --",
    "format": "prettier --check --cache --cache-strategy content --cache-location .cache/prettier .",
    "format:changed": "prettier --check --ignore-unknown --",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "enrollment:schemas": "node scripts/enrollment-proof/export-schemas.ts",
    "render:app-screens": "node scripts/render-app-screens.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.97.0",
    "@agentclientprotocol/codex-acp": "2.3.0",
    "@devcontainers/cli": "0.89.0",
    "@eslint/js": "10.0.1",
    "@expo/plist": "0.10.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex": "0.164.0",
    "@types/node": "26.6.5",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "ignore": "7.0.14",
    "knip": "6.43.0",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "pg-connection-string": "2.14.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "query-string": "file:vendor/expo-router-query-string",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "release-please": "17.11.2",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "uuid": "14.0.3",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "xcode": "4.0.0",
    "zod": "4.6.7"
  }
}
