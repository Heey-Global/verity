{
  "name": "verity",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "description": "Open-core, self-hosted mobile control plane for steering coding agents across a development fleet",
  "engines": {
    "node": "^24.19.0 || >=26.0.0",
    "npm": ">=11.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode@3.0.1": {
      "uuid": "14.0.2"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:runner-worker": "npm run build && node scripts/build-runner-worker.mjs",
    "check:runner-worker": "npm run build && node scripts/build-runner-worker.mjs --check",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "bash scripts/lint.sh",
    "licenses:check": "node scripts/third-party-notices.ts --check",
    "licenses:write": "node scripts/third-party-notices.ts --write",
    "knip": "knip --exports",
    "lint:changed": "eslint --no-warn-ignored --cache --cache-location .cache/eslint --",
    "format": "prettier --check --cache --cache-strategy content --cache-location .cache/prettier .",
    "format:changed": "prettier --check --ignore-unknown --",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "enrollment:schemas": "node scripts/enrollment-proof/export-schemas.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.0",
    "@agentclientprotocol/codex-acp": "1.13.0",
    "@devcontainers/cli": "0.89.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.156.1",
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "ignore": "7.0.10",
    "knip": "6.37.0",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "pg-connection-string": "2.14.0",
    "prettier": "3.9.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "uuid": "14.0.2",
    "vitest": "5.0.1",
    "xcode": "3.0.1",
    "zod": "4.6.5"
  }
}
