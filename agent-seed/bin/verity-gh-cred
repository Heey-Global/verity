#!/usr/bin/env bash
# Git credential helper: return a project capability placeholder for the proxy.
# Store and erase are no-ops; GitHub credentials remain server-side.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

[ "${VERITY_FORGE_MODE:-}" = "proxy-test" ] || exit 1
protocol=""; host=""
while IFS='=' read -r key value; do
  case "$key" in protocol) protocol="$value" ;; host) host="$value" ;; esac
done
[ "$protocol" = "https" ] && { [ "$host" = "github.com" ] || [ "$host" = "github.com:443" ]; } || exit 1
token="$(verity-gh-token)" || exit 1

printf 'username=x-access-token\npassword=%s\n' "$token"
