#!/usr/bin/env bash
# Records an explicit session skip of pre-push lint and format checks.
# Missing compatible dependencies are prepared automatically by the hook;
# requesting a push authorizes that preparation without another question.
# A skip applies only while dependencies are missing and its inputs match.
# Secret scan and code review are not affected.
#
# Usage:
#   verity-local-checks skip     # skip lint/format while dependencies are missing
#   verity-local-checks reset    # forget the skip; prepare dependencies as needed
#   verity-local-checks status   # exit 0 skip active, 1 none, 3 stale (inputs changed)
#
# The per-checkout marker is never committed. Its fingerprint binds the skip
# to package.json and the npm lockfiles; changed inputs invalidate it.
set -euo pipefail

usage() {
  sed -n '9,11p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "verity-local-checks: not inside a git repository" >&2
  exit 1
}
MARKER="${VERITY_LOCAL_CHECKS_MARKER:-$REPO_ROOT/.agents/.local-checks-skip}"

# One line per input file that exists: "<name> <blob id>". `git hash-object` is
# available wherever the hook runs and content-addresses the file without
# needing sha256sum or node; the manifest decides what `npm ci`/`npm install`
# would do, so these three are the inputs the answer is bound to.
fingerprint() {
  local f
  for f in package.json package-lock.json npm-shrinkwrap.json; do
    [ -f "$REPO_ROOT/$f" ] || continue
    printf '%s %s\n' "$f" "$(git hash-object -- "$REPO_ROOT/$f")"
  done
}

case "${1:-}" in
  skip)
    mkdir -p "${MARKER%/*}"
    fingerprint >"$MARKER"
    echo "Lint and format are skipped for this session while dependencies are missing. Secret scan and code review still run." >&2
    echo "Recorded in $MARKER; 'verity-local-checks reset' forgets it." >&2
    ;;
  reset)
    rm -f "$MARKER"
    echo "Lint and format run again on the next push; missing dependencies are prepared automatically." >&2
    ;;
  status)
    [ -f "$MARKER" ] || exit 1
    if [ "$(cat "$MARKER")" = "$(fingerprint)" ]; then
      exit 0
    fi
    exit 3
    ;;
  -h | --help | help) usage ;;
  *) usage ;;
esac
