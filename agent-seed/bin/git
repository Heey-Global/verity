#!/usr/bin/env bash
# Verity git wrapper: worktree lifecycle belongs to the server. A shared
# repository can contain live sessions invisible in this mount namespace;
# prune would delete their indices even though their checkouts still exist.
# It also keeps `git push` from stepping around the agent-seed pre-push gate
# (`--no-verify`, or a one-off `core.hooksPath`): the gate offers a way through
# every block it raises, so bypassing it is never the next step for an agent.
# This is defense in depth, not a filesystem isolation boundary; the enforced
# boundary is branch protection on the code host.
# VERITY_GIT_GUARD_DISABLE=1 is an explicit administrative escape hatch.
set -euo pipefail

# --- locate the real git (never re-enter this wrapper) -----------------------
self="$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")"
REAL_GIT=""
candidates=()
if [ -n "${VERITY_GIT_REAL:-}" ]; then
  candidates+=("$VERITY_GIT_REAL")
fi
candidates+=(/usr/local/lib/verity/git-real /usr/bin/git /usr/local/bin/git /bin/git)
for c in "${candidates[@]}"; do
  if [ -x "$c" ] && [ "$c" != "$self" ]; then
    REAL_GIT="$c"
    break
  fi
done
if [ -z "$REAL_GIT" ]; then
  echo "verity git wrapper: real git binary not found" >&2
  exit 127
fi

# Fully transparent when explicitly disabled.
if [ "${VERITY_GIT_GUARD_DISABLE:-}" = "1" ]; then
  exec "$REAL_GIT" "$@"
fi

args=("$@")
n=${#args[@]}
effective_cwd="$PWD"
hooks_override=""

# A `core.hooksPath` given on the command line displaces the installed seed
# hooks for this one invocation. Keys are case-insensitive in git, so compare
# lowercased; only the key matters, any value is a displacement.
note_config_arg() {
  case "${1,,}" in
    core.hookspath=* | core.hookspath) hooks_override=1 ;;
  esac
}

# The same one-invocation override can arrive through the environment:
# GIT_CONFIG_PARAMETERS (what `-c` becomes for child processes) or the
# GIT_CONFIG_COUNT / GIT_CONFIG_KEY_<n> pairs. The signing broker sets gpg.*
# keys this way, so only the hooks key is looked for.
note_config_env() {
  case "${GIT_CONFIG_PARAMETERS:-}" in
    *[Cc][Oo][Rr][Ee].[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh]*) hooks_override=1 ;;
  esac
  local count="${GIT_CONFIG_COUNT:-}" k name
  case "$count" in '' | *[!0-9]*) return 0 ;; esac
  k=0
  while [ "$k" -lt "$count" ]; do
    name="GIT_CONFIG_KEY_$k"
    note_config_arg "${!name:-}"
    k=$((k + 1))
  done
}

# --- find the subcommand, skipping git's global options ----------------------
# Global options that consume the following argument when given separately.
# Anything else starting with '-' is treated as a valueless flag. Misparsing
# only ever fails OPEN (we exec real git), never falsely blocks.
i=0
subcmd=""
subidx=-1
while [ "$i" -lt "$n" ]; do
  a="${args[$i]}"
  case "$a" in
    -C)
      next="${args[$((i + 1))]:-}"
      if [[ "$next" = /* ]]; then effective_cwd="$next"; else effective_cwd="$effective_cwd/$next"; fi
      effective_cwd="$(realpath -m -- "$effective_cwd" 2>/dev/null || printf '%s' "$effective_cwd")"
      i=$((i + 2))
      continue
      ;;
    -C?*)
      next="${a#-C}"
      if [[ "$next" = /* ]]; then effective_cwd="$next"; else effective_cwd="$effective_cwd/$next"; fi
      effective_cwd="$(realpath -m -- "$effective_cwd" 2>/dev/null || printf '%s' "$effective_cwd")"
      i=$((i + 1))
      continue
      ;;
    -c | --config-env)
      note_config_arg "${args[$((i + 1))]:-}"
      i=$((i + 2))
      continue
      ;;
    -c?*)
      note_config_arg "${a#-c}"
      i=$((i + 1))
      continue
      ;;
    --config-env=*)
      note_config_arg "${a#--config-env=}"
      i=$((i + 1))
      continue
      ;;
    --git-dir | --work-tree | --namespace | --super-prefix)
      i=$((i + 2))
      continue
      ;;
    --)
      i=$((i + 1))
      if [ "$i" -lt "$n" ]; then
        subcmd="${args[$i]}"
        subidx=$i
      fi
      break
      ;;
    -*)
      i=$((i + 1))
      continue
      ;;
    *)
      subcmd="$a"
      subidx=$i
      break
      ;;
  esac
done

# --- push: re-sign members' commits as the pushing person --------------------
# A member without a signing key commits unsigned in a shared session; their
# commits never leave the sandbox, because the forge refuses their pushes. When
# a person who signs pushes the checked-out branch, the unpublished commits from
# the oldest unsigned one onward are replayed with that person as committer and
# signer, while each author stays who wrote the change (ADR 0023 §3: deliberate
# vouching). Commits before it keep their hashes. A rewrite that cannot complete
# is undone and refuses the push; the pre-push hook refuses any unsigned commit
# on other refs. Only for a turn with a person (its badge and committer) and with
# signing enabled; anything else passes untouched.
commit_is_signed() {
  "$REAL_GIT" -C "$effective_cwd" cat-file commit "$1" 2>/dev/null |
    sed '/^$/q' | grep -q '^gpgsig'
}

resign_unpublished() {
  [ -n "${VERITY_TURN_CAPABILITY:-}" ] && [ -n "${GIT_COMMITTER_EMAIL:-}" ] || return 0
  local g=("$REAL_GIT" -C "$effective_cwd")
  [ "$("${g[@]}" config --bool commit.gpgsign 2>/dev/null || true)" = "true" ] || return 0
  "${g[@]}" symbolic-ref -q HEAD >/dev/null 2>&1 || return 0
  local head git_dir
  head="$("${g[@]}" rev-parse --verify -q HEAD)" || return 0
  git_dir="$("${g[@]}" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
  # A rebase, merge or cherry-pick in progress belongs to the agent; the
  # pre-push hook still refuses whatever unsigned commits it would publish.
  if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] ||
    [ -f "$git_dir/MERGE_HEAD" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
    return 0
  fi

  local first="" commit
  while read -r commit; do
    if ! commit_is_signed "$commit"; then
      first="$commit"
      break
    fi
  done < <("${g[@]}" rev-list --reverse --topo-order HEAD --not --remotes 2>/dev/null)
  [ -n "$first" ] || return 0

  # The range replayed: everything on HEAD after the first unsigned commit's
  # (first) parent, or the whole history when it is a root commit.
  local onto range authors count base_short
  if "${g[@]}" rev-parse --verify -q "${first}^1" >/dev/null; then
    onto="$("${g[@]}" rev-parse "${first}^1")"
    range="${onto}..HEAD"
    base_short="$("${g[@]}" rev-parse --short "$onto")"
  else
    onto="--root"
    range="HEAD"
    base_short="--root"
  fi
  count="$("${g[@]}" rev-list --count "$range")"
  authors="$("${g[@]}" log --format='%an' "$range" | sort -u | paste -sd, - | sed 's/,/, /g')"

  local tree_before
  tree_before="$("${g[@]}" rev-parse "HEAD^{tree}")"
  if ! "${g[@]}" rebase --quiet --rebase-merges --force-rebase \
    --reapply-cherry-picks --autostash --gpg-sign "$onto" >/dev/null 2>&1; then
    # Abort restores the branch, index and any autostashed changes exactly.
    # Never reset --hard here: it would discard the changes autostash restored.
    "${g[@]}" rebase --abort >/dev/null 2>&1 || true
    {
      echo "verity git guard: refusing to push unsigned commits by: $authors"
      echo
      echo "Pushing re-signs them with your key, but replaying them onto"
      echo "$base_short failed, for example on a merge whose conflicts must be resolved"
      echo "again. Nothing was changed or pushed. Re-sign them yourself, then push again:"
      echo "  git rebase --rebase-merges --force-rebase --gpg-sign $base_short"
    } >&2
    return 1
  fi
  if [ "$("${g[@]}" rev-parse "HEAD^{tree}")" != "$tree_before" ]; then
    # --keep moves the branch back and keeps uncommitted changes.
    "${g[@]}" reset --quiet --keep "$head" >/dev/null 2>&1 || true
    echo "verity git guard: re-signing changed the content; nothing was pushed" >&2
    return 1
  fi

  # The commits are the same change; a review recorded for the old tip covers
  # the new one, whose tree was just checked to be identical.
  local marker top
  top="$("${g[@]}" rev-parse --show-toplevel 2>/dev/null || true)"
  marker="${VERITY_CODE_REVIEW_MARKER:-${top}/.agents/.last-code-review-sha}"
  if [ -n "$top" ] && [ -f "$marker" ] &&
    [ "$(head -n1 "$marker" | tr -d '[:space:]')" = "$head" ]; then
    "${g[@]}" rev-parse HEAD >"$marker"
  fi
  echo "verity git guard: re-signed $count commit(s) by $authors with your key" >&2
  return 0
}

# --- push: the pre-push gate is not optional ---------------------------------
# A push without the flag passes untouched, dry run or not. git accepts any
# unambiguous abbreviation of a long option, and `--no-veri` is the shortest
# one that is not also a prefix of `--no-verbose`, so the three spellings from
# there up are refused. Options after `--` are refspecs, not flags.
if [ "$subcmd" = "push" ]; then
  note_config_env
  no_verify=""
  j=$((subidx + 1))
  while [ "$j" -lt "$n" ]; do
    a="${args[$j]}"
    case "$a" in
      --) break ;;
      --no-veri | --no-verif | --no-verify) no_verify=1 ;;
    esac
    j=$((j + 1))
  done
  if [ -n "$no_verify" ] || [ -n "$hooks_override" ]; then
    {
      if [ -n "$no_verify" ]; then
        echo "verity git guard: refusing 'git push --no-verify'"
      else
        echo "verity git guard: refusing 'git push' with a core.hooksPath override"
      fi
      echo
      echo "The pre-push gate names a way through every block it raises:"
      echo "  code review     verity-code-review run, then verity-code-review mark"
      echo "  lint/format     fix check errors or dependency preparation; explicit skip: verity-local-checks skip"
      echo "  secret          rewrite the commit, or add the fingerprint to .gitleaksignore"
      echo "If this is an operator-directed push, re-run with VERITY_GIT_GUARD_DISABLE=1."
    } >&2
    exit 1
  fi
  resign_unpublished || exit 1
  exec "$REAL_GIT" "$@"
fi

if [ "$subcmd" != "worktree" ]; then
  exec "$REAL_GIT" "$@"
fi

# --- find the worktree action (first non-option after "worktree") ------------
j=$((subidx + 1))
action=""
actidx=-1
while [ "$j" -lt "$n" ]; do
  a="${args[$j]}"
  case "$a" in
    -*)
      j=$((j + 1))
      continue
      ;;
    *)
      action="$a"
      actidx=$j
      break
      ;;
  esac
done

case "$action" in
  prune | unlock | move | repair)
    echo "verity git guard: refusing 'git worktree $action'; Verity owns worktree administration" >&2
    exit 1
    ;;
esac

if [ "$action" != "remove" ]; then
  exec "$REAL_GIT" "$@"
fi

# --- collect target path(s) after "remove" -----------------------------------
targets=()
k=$((actidx + 1))
while [ "$k" -lt "$n" ]; do
  a="${args[$k]}"
  case "$a" in
    --)
      k=$((k + 1))
      while [ "$k" -lt "$n" ]; do
        targets+=("${args[$k]}")
        k=$((k + 1))
      done
      break
      ;;
    -*)
      k=$((k + 1))
      continue
      ;;
    *)
      targets+=("$a")
      k=$((k + 1))
      ;;
  esac
done

# No target given (`git worktree remove` with no path is a usage error): let the
# real git report it. Also avoids expanding an empty array under `set -u`.
if [ "${#targets[@]}" -eq 0 ]; then
  exec "$REAL_GIT" "$@"
fi

# --- resolve paths and decide -------------------------------------------------
resolve() {
  local p="$1"
  [ -z "$p" ] && return 0
  if [[ "$p" != /* ]]; then p="$effective_cwd/$p"; fi
  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$p" 2>/dev/null || printf '%s' "$p"
  else
    printf '%s' "$p"
  fi
}

# The worktree we are currently standing in (deployment-independent self-check).
global_args=("${args[@]:0:$subidx}")
current="$("$REAL_GIT" "${global_args[@]}" rev-parse --show-toplevel 2>/dev/null || true)"
current="$(resolve "$current")"

for t in "${targets[@]}"; do
  rt="$(resolve "$t")"
  blocked=""
  # 1) Self-removal: removing the worktree this process is running inside.
  if [ -n "$current" ] && [ "$rt" = "$current" ]; then
    blocked="self"
  fi
  # 2) Any Verity session worktree (.verity-sessions/agent-<id>), regardless of cwd.
  case "$rt" in
    */.verity-sessions/agent-*) blocked="session" ;;
  esac

  if [ -n "$blocked" ]; then
    {
      echo "verity git guard: refusing 'git worktree remove' on a Verity session worktree"
      echo "  target: $rt"
      echo
      echo "A session must not remove its own (or another session's) worktree. Verity"
      echo "owns worktree lifecycle and removes the tree server-side after the PR merges;"
      echo "self-removal permanently breaks the session ('workspace no longer exists')."
      echo "If this is an operator-directed removal, re-run with VERITY_GIT_GUARD_DISABLE=1."
    } >&2
    exit 1
  fi
done

exec "$REAL_GIT" "$@"
