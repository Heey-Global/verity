#!/usr/bin/env bash
# Runtime-neutral secret scan behind the Verity agent-seed git hooks.
#
#   verity-secret-scan staged                 scan the staged diff   (pre-commit)
#   verity-secret-scan range <base> [<tip>]   scan <base>..<tip>     (pre-push)
#   verity-secret-scan history [<tip>]        scan everything reachable from
#                                             <tip>, or from every ref when no
#                                             tip is given (pre-push fallback)
#
# <tip> defaults to HEAD. It is explicit because a pre-push hook is told which
# refs are being pushed, and those are not necessarily the checked-out branch.
#
# Exit codes are the contract the hooks branch on:
#   0  clean, or deliberately skipped (no scanner and no repo opt-in)
#   1  findings — a secret is in the staged diff / pushed range
#   2  the gate itself cannot run (missing scanner where the repo declares
#      scanning, bad usage, scanner crash) — hooks must treat this as BLOCKED
#
# Why local scanning at all: the Heey-Global org ruleset already runs gitleaks
# in CI for main/staging, but that fires only AFTER the commit reached GitHub.
# A pushed secret is burned — it must be rotated even if the history is rewritten
# minutes later. Scanning at commit/push time keeps it inside the sandbox.

set -euo pipefail

MODE="${1:-}"
GITLEAKS="${VERITY_GITLEAKS_BIN:-gitleaks}"

usage() {
  cat >&2 <<'EOF'
usage: verity-secret-scan staged
       verity-secret-scan range <base-commit> [<tip>]
       verity-secret-scan history [<tip>]
EOF
}

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$REPO_ROOT" ]; then
  echo "verity-secret-scan: not inside a git repository" >&2
  exit 2
fi

# Does this repository expect secret scanning? Any gitleaks artifact counts: a
# ruleset, a baseline of allowlisted fingerprints, or a repo-local workflow.
# Verity itself qualifies through .gitleaksignore.
declares_secret_scanning() {
  [ -f "$REPO_ROOT/.gitleaks.toml" ] \
    || [ -f "$REPO_ROOT/gitleaks.toml" ] \
    || [ -f "$REPO_ROOT/.gitleaksignore" ] \
    || [ -f "$REPO_ROOT/.github/workflows/gitleaks.yml" ]
}

# Whenever gitleaks IS available the scan runs, with its default ruleset and
# regardless of whether the repository opted in: an agent about to commit a live
# credential is a problem in any repository, and Verity sessions work across many
# repos that will never carry a gitleaks config of their own.
#
# The repo opt-in only decides what a MISSING scanner means. The hooks are
# installed globally (core.hooksPath) and also run in project containers built
# from images Verity does not control. Fail CLOSED where the repository declares
# scanning — silently deferring to CI is exactly the gap this gate closes — and
# stay silent elsewhere rather than blocking every commit in a container that was
# never provisioned for it.
if ! command -v "$GITLEAKS" >/dev/null 2>&1; then
  if declares_secret_scanning; then
    cat >&2 <<EOF
verity-secret-scan: BLOCKED - gitleaks is not installed

${REPO_ROOT##*/} declares secret scanning (.gitleaksignore / .gitleaks.toml),
but no 'gitleaks' binary is on PATH, so the local gate cannot run.

This is a container-provisioning bug, not something to work around here: the
verity-sandbox-toolkit Feature installs a pinned gitleaks. Report the missing
tool and rebuild the container rather than pushing unscanned commits.
EOF
    exit 2
  fi
  exit 0
fi

# --exit-code 3 separates "found secrets" (3) from "gitleaks itself failed" (1),
# which the default shares. --redact keeps secret material out of the hook output
# and therefore out of the agent transcript; -v still prints file, line, rule and
# the fingerprint an operator needs for an allowlist entry. --gitleaks-ignore-path
# is passed explicitly because it defaults to the CWD, and a hook's CWD is not
# guaranteed to be the repo root.
ARGS=(
  git
  -v
  --redact
  --no-banner
  --log-level warn
  --exit-code 3
  --gitleaks-ignore-path "$REPO_ROOT"
)

# gitleaks resolves its ruleset from --config, then GITLEAKS_CONFIG(_TOML), then
# a `.gitleaks.toml` inside the scanned path, then its built-in default. Only the
# dotted name is auto-loaded, so a repository shipping the undotted `gitleaks.toml`
# would be scanned here with the default rules while CI uses its custom ones —
# exactly the drift this gate is supposed to remove. Point --config at whichever
# file the repository ships; an explicit environment override stays authoritative.
if [ -z "${GITLEAKS_CONFIG:-}" ] && [ -z "${GITLEAKS_CONFIG_TOML:-}" ]; then
  for CONFIG in "$REPO_ROOT/.gitleaks.toml" "$REPO_ROOT/gitleaks.toml"; do
    if [ -f "$CONFIG" ]; then
      ARGS+=(--config "$CONFIG")
      break
    fi
  done
fi

case "$MODE" in
  staged)
    ARGS+=(--staged)
    ;;
  range)
    BASE="${2:-}"
    if [ -z "$BASE" ]; then
      usage
      exit 2
    fi
    ARGS+=(--log-opts="$BASE..${3:-HEAD}")
    ;;
  history)
    # No tip: no --log-opts at all, so gitleaks walks every ref.
    if [ -n "${2:-}" ]; then
      ARGS+=(--log-opts="$2")
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

ARGS+=("$REPO_ROOT")

# gitleaks prints findings on stdout; hooks report on stderr, so redirect. The
# status is captured rather than propagated by `set -e` so a scanner crash can be
# told apart from a finding.
STATUS=0
"$GITLEAKS" "${ARGS[@]}" >&2 || STATUS=$?

case "$STATUS" in
  0) exit 0 ;;
  3) exit 1 ;;
  *)
    echo "verity-secret-scan: gitleaks exited with status $STATUS (scan did not complete)" >&2
    exit 2
    ;;
esac
