#!/usr/bin/env node
// Prepare dependencies centrally; activate independent files in each worktree.
import { execFileSync, spawn, spawnSync } from 'node:child_process';
import { createHash, randomUUID } from 'node:crypto';
import {
  existsSync,
  readFileSync,
  realpathSync,
  readdirSync,
  lstatSync,
  readlinkSync,
  cpSync,
  mkdirSync,
  renameSync,
  rmSync,
  writeFileSync,
  symlinkSync,
  openSync,
  closeSync,
  readSync,
  statSync,
  chmodSync,
} from 'node:fs';
import { dirname, join, resolve, isAbsolute, relative } from 'node:path';
import { pathToFileURL } from 'node:url';

function git(...args) {
  return execFileSync('git', args, {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  }).trim();
}
function read(path) {
  try {
    return readFileSync(path, 'utf8');
  } catch {
    return undefined;
  }
}
function npmEnvironment() {
  const environment = { ...process.env };
  for (const key of [
    'NPM_CONFIG_USERCONFIG',
    'npm_config_userconfig',
    'NPM_CONFIG_GLOBALCONFIG',
    'npm_config_globalconfig',
  ]) {
    if (environment[key]) environment[key] = resolve(environment[key]);
  }
  return environment;
}
function manager(root) {
  const declared = JSON.parse(read(join(root, 'package.json')) ?? '{}').packageManager;
  if (typeof declared === 'string' && /^(yarn|pnpm)@/.test(declared)) return declared.split('@')[0];
  if (existsSync(join(root, 'pnpm-lock.yaml'))) return 'pnpm';
  if (existsSync(join(root, 'yarn.lock'))) return 'yarn';
  return 'npm';
}
function installed(root) {
  try {
    const selected = manager(root);
    if (selected === 'pnpm')
      return (
        existsSync(join(root, 'node_modules', '.modules.yaml')) &&
        read(join(root, 'pnpm-lock.yaml')) !== undefined &&
        read(join(root, 'node_modules', '.pnpm', 'lock.yaml')) ===
          read(join(root, 'pnpm-lock.yaml'))
      );
    if (selected === 'yarn') {
      // Receipt presence alone cannot prove current manifests/lockfile were installed.
      // Classic's integrity check is read-only; unsupported managers fail closed.
      if (!existsSync(join(root, 'node_modules', '.yarn-integrity'))) return false;
      return (
        spawnSync('yarn', ['check', '--integrity', '--offline'], {
          cwd: root,
          stdio: 'ignore',
          timeout: 10_000,
        }).status === 0
      );
    }
    const receipt = JSON.parse(read(join(root, 'node_modules', '.package-lock.json')) ?? 'null');
    if (!receipt || !receipt.packages || typeof receipt.packages !== 'object') return false;
    const source = read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json'));
    if (!source) return true;
    const lock = JSON.parse(source);
    let packages = lock.packages;
    if (
      lock.lockfileVersion === 1 &&
      !packages &&
      (lock.dependencies === undefined || typeof lock.dependencies === 'object')
    ) {
      packages = {};
      const collect = (dependencies, prefix = '') => {
        for (const [name, entry] of Object.entries(dependencies)) {
          const path = `${prefix}node_modules/${name}`;
          packages[path] = entry;
          if (entry.dependencies) collect(entry.dependencies, `${path}/`);
        }
      };
      collect(lock.dependencies ?? {});
    }
    if (!packages || typeof packages !== 'object') return false;
    return Object.entries(packages).every(([path, wanted]) => {
      if (!path.startsWith('node_modules/') && !path.includes('/node_modules/')) return true;
      if (path.split('/').includes('..')) return false;
      if (wanted.link) {
        if (typeof wanted.resolved !== 'string') return false;
        const target = resolve(root, wanted.resolved);
        return (
          lstatSync(join(root, path)).isSymbolicLink() &&
          realpathSync(join(root, path)) === realpathSync(target) &&
          existsSync(join(target, 'package.json'))
        );
      }
      const actual = receipt.packages[path];
      if (!actual) return wanted.optional === true || wanted.devOptional === true;
      return (
        actual.version === wanted.version &&
        actual.integrity === wanted.integrity &&
        existsSync(join(root, path, 'package.json'))
      );
    });
  } catch {
    return false;
  }
}
/** Compare install inputs, excluding release-only workspace versions and scripts. */
function dependencyInputIdentity(path, source) {
  const fields = [
    'name',
    'dependencies',
    'devDependencies',
    'peerDependencies',
    'peerDependenciesMeta',
    'optionalDependencies',
    'overrides',
    'resolutions',
    'workspaces',
    'packageManager',
    'engines',
    'os',
    'cpu',
    'libc',
    'bin',
  ];
  const manifest = (value) =>
    Object.fromEntries(fields.filter((key) => key in value).map((key) => [key, value[key]]));
  const sort = (value) =>
    Array.isArray(value)
      ? value.map(sort)
      : value !== null && typeof value === 'object'
        ? Object.fromEntries(
            Object.entries(value)
              .sort(([a], [b]) => a.localeCompare(b))
              .map(([key, item]) => [key, sort(item)]),
          )
        : value;
  if (!/(^|\/)(package.json|package-lock.json|npm-shrinkwrap.json)$/.test(path)) return source;
  const value = JSON.parse(source);
  if (path.endsWith('package.json')) return JSON.stringify(sort(manifest(value)));
  if (!value.packages || typeof value.packages !== 'object') return JSON.stringify(sort(value));
  return JSON.stringify(
    sort({
      lockfileVersion: value.lockfileVersion,
      packages: Object.fromEntries(
        Object.entries(value.packages).map(([name, entry]) => [
          name,
          name.startsWith('node_modules/') || name.includes('/node_modules/')
            ? entry
            : manifest(entry),
        ]),
      ),
    }),
  );
}

function compatible(root, base) {
  const files = git('-C', root, 'ls-files', '-z')
    .split('\0')
    .filter((p) =>
      /(^|\/)(package.json|package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|pnpm-workspace.yaml|.npmrc)$/.test(
        p,
      ),
    );
  if (!files.includes('package.json') || !files.some((p) => /lock/.test(p))) return false;
  const baseFiles = git('-C', base, 'ls-files', '-z')
    .split('\0')
    .filter((p) =>
      /(^|\/)(package.json|package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|pnpm-workspace.yaml|.npmrc)$/.test(
        p,
      ),
    );
  if (files.join('\0') !== baseFiles.join('\0')) return false;
  if (
    git(
      '-C',
      root,
      'ls-files',
      '--others',
      '--exclude-standard',
      '--',
      '**/package.json',
      'package.json',
    )
  )
    return false;
  return files.every(
    (p) =>
      read(join(root, p)) !== undefined &&
      read(join(base, p)) !== undefined &&
      dependencyInputIdentity(p, read(join(root, p))) ===
        dependencyInputIdentity(p, read(join(base, p))),
  );
}
function privateSkeleton(root) {
  const modules = join(root, 'node_modules');
  if (!existsSync(modules)) return true;
  if (!lstatSync(modules).isDirectory() || lstatSync(modules).isSymbolicLink()) return false;
  const sources = new Map();
  for (const path of git('-C', root, 'ls-files', '-z').split('\0')) {
    if (!path.endsWith('/package.json')) continue;
    const manifest = JSON.parse(read(join(root, path)) ?? '{}');
    if (typeof manifest.name === 'string') sources.set(manifest.name, dirname(join(root, path)));
  }
  const valid = (name, path) =>
    lstatSync(path).isSymbolicLink() &&
    sources.get(name) === resolve(dirname(path), readlinkSync(path));
  for (const name of readdirSync(modules)) {
    const path = join(modules, name);
    if (
      name.startsWith('@') &&
      lstatSync(path).isDirectory() &&
      !lstatSync(path).isSymbolicLink()
    ) {
      if (!readdirSync(path).every((child) => valid(`${name}/${child}`, join(path, child))))
        return false;
    } else if (!valid(name, path)) return false;
  }
  return true;
}
// A receipt is published only after the native manager and completeness check succeed.
// Cache entries contain independent copies, never hardlinks to writable session packages.
function packedSources(root) {
  const lock = JSON.parse(
    read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json')) ?? 'null',
  );
  const entries = lock?.packages ? Object.values(lock.packages) : [];
  const collect = (dependencies) => {
    for (const value of Object.values(dependencies ?? {})) {
      entries.push(value);
      collect(value.dependencies);
    }
  };
  if (!lock?.packages) collect(lock?.dependencies);
  return [
    ...new Set(
      entries
        .filter(
          (value) =>
            !value.link && typeof value.resolved === 'string' && value.resolved.startsWith('file:'),
        )
        .map((value) => value.resolved),
    ),
  ].sort();
}
function packedSourceIdentity(root, sources) {
  const hash = createHash('sha256');
  const buffer = Buffer.allocUnsafe(64 * 1024);
  let files = 0;
  let bytes = 0;
  for (const source of sources) {
    const directory = resolve(root, decodeURIComponent(source.slice('file:'.length)));
    const manifest = JSON.parse(read(join(directory, 'package.json')) ?? '{}');
    const bundles = manifest.bundledDependencies ?? manifest.bundleDependencies;
    const bundled = bundles === true || (Array.isArray(bundles) && bundles.length > 0);
    const visit = (path, name) => {
      if (++files > 10000)
        throw new Error(
          'Packed local dependency sources exceed the 10000-entry verification bound; use a linked dependency or publish the package before preparing dependencies.',
        );
      const stat = lstatSync(path);
      hash.update(source + '\0' + name + '\0' + String(stat.mode & 0o111) + '\0');
      if (stat.isDirectory()) {
        for (const entry of readdirSync(path).sort()) {
          if (entry === '.git' || (entry === 'node_modules' && !bundled)) continue;
          visit(join(path, entry), name + '/' + entry);
        }
      } else if (stat.isFile()) {
        bytes += stat.size;
        if (bytes > 64 * 1024 * 1024)
          throw new Error(
            'Packed local dependency sources exceed the 64 MiB verification bound; use a linked dependency or publish the package before preparing dependencies.',
          );
        const fd = openSync(path, 'r');
        try {
          let length;
          while ((length = readSync(fd, buffer)) > 0) hash.update(buffer.subarray(0, length));
        } finally {
          closeSync(fd);
        }
        hash.update('\0');
      } else {
        throw new Error(
          'Packed local dependency sources contain a symlink or unsupported file; use a linked dependency or publish the package before preparing dependencies.',
        );
      }
    };
    visit(directory, '');
  }
  return hash.digest('hex');
}
function inputFiles(root) {
  const files = git('-C', root, 'ls-files', '--cached', '--others', '--exclude-standard', '-z')
    .split('\0')
    .filter((path) =>
      /(^|\/)(package.json|package-lock.json|npm-shrinkwrap.json|.npmrc)$/.test(path),
    )
    .sort();
  // Effective project configuration matters even when .npmrc is gitignored.
  return [
    ...new Set([
      ...files,
      '.npmrc',
      ...files
        .filter((path) => /(^|\/)package.json$/u.test(path))
        .map((path) => join(dirname(path), '.npmrc')),
    ]),
  ].sort();
}
function identity(root, inputs = root) {
  const hash = createHash('sha256');
  hash.update('central-preparation-v1\0');
  hash.update(packedSourceIdentity(inputs, packedSources(inputs)));
  for (const path of inputFiles(root)) {
    const source = read(join(inputs, path));
    if (source !== undefined)
      hash.update(path + '\0' + dependencyInputIdentity(path, source) + '\0');
  }
  const userConfig =
    process.env.NPM_CONFIG_USERCONFIG ??
    process.env.npm_config_userconfig ??
    join(process.env.HOME ?? '', '.npmrc');
  hash.update('user-config\0' + (read(userConfig) ?? '') + '\0');
  const globalConfig = spawnSync('npm', ['config', 'get', 'globalconfig'], {
    cwd: inputs,
    env: npmEnvironment(),
    encoding: 'utf8',
    timeout: 10_000,
  });
  const globalPath = globalConfig.stdout?.trim();
  if (
    globalConfig.status !== 0 ||
    !globalPath ||
    !isAbsolute(globalPath) ||
    /[\r\n]/.test(globalPath)
  )
    throw new Error(
      'Cannot determine effective npm global configuration for dependency compatibility.',
    );
  hash.update('global-config\0' + (read(globalPath) ?? '') + '\0');
  const version = spawnSync('npm', ['--version'], {
    cwd: inputs,
    env: npmEnvironment(),
    encoding: 'utf8',
    timeout: 10_000,
  });
  if (version.status !== 0)
    throw new Error('Cannot determine npm version for dependency compatibility.');
  const configuration = Object.entries(process.env)
    .filter(([key]) => /^npm_config_/i.test(key))
    .sort(([left], [right]) => left.localeCompare(right));
  hash.update(
    JSON.stringify([
      process.version,
      process.platform,
      process.arch,
      process.platform === 'linux'
        ? (process.report.getReport().header.glibcVersionRuntime ?? 'musl')
        : process.platform,
      version.stdout.trim(),
      configuration,
    ]),
  );
  return hash.digest('hex');
}
function receiptMatches(root, value) {
  const receipt = read(join(root, 'node_modules', '.verity-install.json'));
  try {
    return receipt !== undefined && JSON.parse(receipt)?.identity === value;
  } catch {
    return false;
  }
}

function cacheable(root) {
  const lock = JSON.parse(
    read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json')) ?? 'null',
  );
  if (!lock?.packages) return false;
  return Object.entries(lock.packages).every(([path, value]) => {
    if (isAbsolute(path) || path.split('/').includes('..')) return false;
    if (path.includes('/node_modules/') && !path.startsWith('node_modules/')) return false;
    if (!value.link) return true;
    if (typeof value.resolved !== 'string' || isAbsolute(value.resolved)) return false;
    const target = relative(root, resolve(root, value.resolved));
    return target !== '..' && !target.startsWith('../');
  });
}
function stagedInputIdentity(root) {
  const hash = createHash('sha256');
  let count = 0;
  let bytes = 0;
  const visit = (directory) => {
    for (const name of readdirSync(directory).sort()) {
      if (['node_modules', '.git', '.cache'].includes(name)) continue;
      if (directory === root && ['receipt.json', '.verity-inputs.sha256'].includes(name)) continue;
      if (++count > 10000)
        throw new Error('Staged dependency inputs exceed the 10000-entry verification bound.');
      const path = join(directory, name);
      const stat = lstatSync(path);
      if (stat.isSymbolicLink()) throw new Error('Unexpected symlink in staged dependency inputs.');
      if (stat.isDirectory()) visit(path);
      else if (
        ['package.json', 'package-lock.json', 'npm-shrinkwrap.json', '.npmrc'].includes(name)
      ) {
        bytes += stat.size;
        if (bytes > 64 * 1024 ** 2)
          throw new Error('Staged dependency inputs exceed the 64 MiB verification bound.');
        hash.update(relative(root, path) + '\0' + dependencyInputIdentity(path, read(path)) + '\0');
      }
    }
  };
  visit(root);
  return hash.digest('hex');
}
function cachedReady(root, cache, expected) {
  try {
    return (
      read(join(cache, 'receipt.json')) === expected &&
      receiptMatches(cache, expected) &&
      installed(cache) &&
      read(join(cache, '.verity-inputs.sha256')) === stagedInputIdentity(cache) &&
      identity(root, cache) === expected
    );
  } catch {
    return false;
  }
}
function contained(root, path) {
  const rel = relative(root, path);
  return rel !== '..' && !rel.startsWith('../') && !isAbsolute(rel);
}
function stageInputs(root, stage) {
  mkdirSync(stage, { recursive: true, mode: 0o700 });
  for (const path of inputFiles(root)) {
    const source = join(root, path);
    if (!existsSync(source)) continue;
    if (!contained(root, realpathSync(source)) || !lstatSync(source).isFile())
      throw new Error('Dependency input must be a regular file inside the project.');
    mkdirSync(dirname(join(stage, path)), { recursive: true });
    cpSync(source, join(stage, path));
  }
  for (const source of packedSources(root)) {
    const path = decodeURIComponent(source.slice('file:'.length));
    const directory = resolve(root, path);
    if (isAbsolute(path) || !contained(root, directory) || directory === root)
      throw new Error('Central preparation requires local package sources inside the project.');
    const manifest = JSON.parse(read(join(directory, 'package.json')) ?? '{}');
    const bundles = manifest.bundledDependencies ?? manifest.bundleDependencies;
    const bundled = bundles === true || (Array.isArray(bundles) && bundles.length > 0);
    cpSync(directory, resolve(stage, path), {
      recursive: true,
      filter: (entry) => {
        const name = relative(directory, entry).split('/');
        return !name.includes('.git') && (bundled || !name.includes('node_modules'));
      },
    });
  }
}
function readinessReason(root, expected) {
  if (!existsSync(join(root, 'node_modules'))) return 'missing installation';
  if (!read(join(root, 'node_modules', '.verity-install.json')))
    return 'missing managed installation receipt';
  if (!receiptMatches(root, expected))
    return 'dependency inputs, configuration or runtime differ from the installation receipt';
  if (!workspaceLinksReady(root)) return 'workspace links do not target this worktree';
  return 'missing packages or package versions/integrities differ from the lockfile';
}
function fixWorkspaceBin(root, source) {
  if (!readlinkExists(source)) return; // Build outputs may not exist yet.
  if (!lstatSync(source).isFile() || !contained(realpathSync(root), realpathSync(source)))
    throw new Error('Workspace executable must be a regular file inside the project.');
  const stat = statSync(source);
  const fd = openSync(source, 'r');
  const header = Buffer.alloc(2048);
  let length;
  try {
    length = readSync(fd, header);
  } finally {
    closeSync(fd);
  }
  const newline = header.subarray(0, length).indexOf(10);
  const mode = (stat.mode & 0o777) | 0o111;
  if (header[0] === 35 && header[1] === 33 && newline > 1 && header[newline - 1] === 13) {
    // Match npm's shebang repair without buffering arbitrarily large executables.
    if (stat.size > 1024 ** 2)
      throw new Error(
        'Workspace executable with a CRLF shebang exceeds the 1 MiB normalization bound.',
      );
    const content = readFileSync(source);
    const temporary = source + '.verity-bin-' + randomUUID();
    try {
      writeFileSync(
        temporary,
        Buffer.concat([content.subarray(0, newline - 1), content.subarray(newline)]),
        { mode },
      );
      chmodSync(temporary, mode);
      renameSync(temporary, source);
    } finally {
      rmSync(temporary, { force: true });
    }
  } else {
    chmodSync(source, mode);
  }
}
function rewire(root, modules) {
  const lock = JSON.parse(
    read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json')),
  );
  for (const [path, value] of Object.entries(lock.packages)) {
    if (!value.link || !path.startsWith('node_modules/')) continue;
    const target = join(modules, path.slice('node_modules/'.length));
    // Only a declared workspace symlink is replaced, never package contents.
    if (!contained(modules, realpathSync(dirname(target))))
      throw new Error('Cached workspace parent escapes the activation directory.');
    if (!lstatSync(target).isSymbolicLink())
      throw new Error('Cached workspace link is not a symlink.');
    rmSync(target);
    symlinkSync(relative(dirname(join(root, path)), resolve(root, value.resolved)), target);
    const manifest = JSON.parse(read(join(root, value.resolved, 'package.json')) ?? '{}');
    const bins =
      typeof manifest.bin === 'string'
        ? { [manifest.name?.split('/').pop()]: manifest.bin }
        : (manifest.bin ?? {});
    for (const [name, entry] of Object.entries(bins)) {
      if (
        !name ||
        name === '.' ||
        name === '..' ||
        /[/\\]/u.test(name) ||
        typeof entry !== 'string' ||
        isAbsolute(entry)
      )
        throw new Error('Unsupported workspace executable path.');
      const source = resolve(root, value.resolved, entry);
      if (!contained(root, source))
        throw new Error('Workspace executable must stay inside the project.');
      const binDirectory = join(modules, '.bin');
      if (
        readlinkExists(binDirectory) &&
        (!lstatSync(binDirectory).isDirectory() || lstatSync(binDirectory).isSymbolicLink())
      )
        throw new Error('Workspace executable directory must not be a symlink.');
      mkdirSync(binDirectory, { recursive: true });
      const executable = join(binDirectory, name);
      fixWorkspaceBin(root, source);
      // npm skips workspace bins whose sources are absent in central staging.
      // Keep native collision choices; add only missing links to current sources.
      if (!readlinkExists(executable))
        symlinkSync(relative(join(root, 'node_modules', '.bin'), source), executable);
    }
  }
}
function workspaceLinksReady(root) {
  try {
    const lock = JSON.parse(
      read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json')) ?? 'null',
    );
    return Object.entries(lock?.packages ?? {}).every(
      ([path, value]) =>
        !value.link ||
        !path.startsWith('node_modules/') ||
        (lstatSync(join(root, path)).isSymbolicLink() &&
          realpathSync(join(root, path)) === realpathSync(resolve(root, value.resolved))),
    );
  } catch {
    return false;
  }
}
function restoreWorkspaceLinks(root) {
  const lock = JSON.parse(
    read(join(root, 'npm-shrinkwrap.json')) ?? read(join(root, 'package-lock.json')) ?? 'null',
  );
  for (const [path, value] of Object.entries(lock?.packages ?? {})) {
    if (!value.link || !path.startsWith('node_modules/') || path.split('/').includes('..'))
      continue;
    const link = join(root, path);
    if (readlinkExists(link)) continue;
    const target = resolve(root, value.resolved);
    mkdirSync(dirname(link), { recursive: true });
    symlinkSync(relative(dirname(link), target), link);
  }
}
function sharedReady(root, base, ignorePrivate = false) {
  if (packedSources(root).length > 0) return false;
  if (
    (!ignorePrivate && !privateSkeleton(root)) ||
    root === base ||
    existsSync(join(base, '.pnp.cjs')) ||
    !compatible(root, base)
  )
    return false;
  let parent = dirname(root);
  while (parent !== dirname(parent)) {
    const modules = join(parent, 'node_modules');
    if (
      existsSync(modules) &&
      installed(base) &&
      realpathSync(modules) === realpathSync(join(base, 'node_modules'))
    )
      return true;
    parent = dirname(parent);
  }
  return false;
}
async function lock(path, wait = true) {
  mkdirSync(dirname(path), { recursive: true });
  // flock locks the shared open-file description. Children inherit descriptor 3,
  // retaining the lock even if the supervising helper is killed before they exit.
  const fd = openSync(path, 'a');
  try {
    const status = await new Promise((done, reject) => {
      const child = spawn('flock', wait ? ['-w', '90', '3'] : ['-n', '3'], {
        stdio: ['ignore', 'ignore', 'ignore', fd],
      });
      child.on('error', reject);
      child.on('close', done);
    });
    if (!wait && status === 1) {
      closeSync(fd);
      return undefined;
    }
    if (status !== 0)
      throw new Error(
        'Dependency preparation lock unavailable or still busy after 90 seconds; retry after the active preparation finishes.',
      );
    return { fd, release: () => closeSync(fd) };
  } catch (error) {
    closeSync(fd);
    throw error;
  }
}

async function snapshotSlot(cacheRoot, currentIdentity) {
  const names = readdirSync(cacheRoot).filter(
    (name) => /^[a-f0-9]{64}$/.test(name) && name !== currentIdentity,
  );
  if (names.length < 2) return true;
  const generated = names
    .filter((name) => {
      try {
        const directory = join(cacheRoot, name);
        return (
          lstatSync(directory).isDirectory() &&
          read(join(directory, 'receipt.json')) === name &&
          JSON.parse(read(join(directory, 'node_modules', '.verity-install.json'))).identity ===
            name
        );
      } catch {
        return false;
      }
    })
    .sort(
      (left, right) =>
        statSync(join(cacheRoot, left, 'receipt.json')).mtimeMs -
        statSync(join(cacheRoot, right, 'receipt.json')).mtimeMs,
    );
  let remaining = names.length;
  for (const name of generated) {
    if (name === currentIdentity) continue;
    // Publication is serialized, but another preparation may own its identity
    // while waiting to publish. Never wait here: that would invert lock order.
    const guard = await lock(join(cacheRoot, name + '.lock'), false);
    if (!guard) continue;
    try {
      const directory = join(cacheRoot, name);
      if (read(join(directory, 'receipt.json')) !== name) continue;
      // These are disposable generated copies, never active node_modules or
      // preserved recovery files. Rename before removal to withdraw atomically.
      const retired = join(cacheRoot, '.retired-' + randomUUID());
      renameSync(directory, retired);
      rmSync(retired, { recursive: true });
      if (--remaining < 2) return true;
    } finally {
      guard.release();
    }
  }
  return false;
}
const directory = '/usr/local/lib/verity';
async function packagePolicy(root, rootLockFd, prepare = false) {
  if (!process.env.VERITY_SESSION_ID) return;
  if (
    !existsSync(join(directory, 'verity-npm-preflight.mjs')) ||
    !existsSync(join(directory, 'verity-package-install.mjs'))
  ) {
    throw new Error(
      'Dependency reuse requires the updated package-age verifier; rebuild the project sandbox before running checks.',
    );
  }
  const child = spawn(
    process.execPath,
    [
      join(directory, 'verity-package-install.mjs'),
      'npm',
      ...(prepare ? ['--verity-prepare-only'] : ['ci', '--verity-verify-only']),
    ],
    {
      cwd: root,
      stdio: rootLockFd === undefined ? 'inherit' : ['inherit', 'inherit', 'inherit', rootLockFd],
      env:
        rootLockFd === undefined
          ? npmEnvironment()
          : { ...npmEnvironment(), VERITY_NPM_LOCK_FD: '3' },
    },
  );
  const handlers = ['SIGINT', 'SIGTERM'].map((signal) => {
    const handler = () => child.kill(signal);
    process.on(signal, handler);
    return [signal, handler];
  });
  try {
    const result = await new Promise((done, reject) => {
      child.on('error', reject);
      child.on('exit', (code, signal) => done({ code, signal }));
    });
    if (result.code !== 0 || result.signal)
      throw new Error(
        prepare
          ? 'Package protection preparation failed or was interrupted; installation remains blocked.'
          : 'Reused dependency age verification failed or was interrupted; checks remain blocked.',
      );
  } finally {
    handlers.forEach(([signal, handler]) => process.removeListener(signal, handler));
  }
}
async function main() {
  const root = git('rev-parse', '--show-toplevel');
  const common = resolve(root, git('rev-parse', '--git-common-dir'));
  const base = dirname(common);
  const action = process.argv[2] ?? 'status';
  if (!['status', 'install'].includes(action))
    throw new Error('Usage: verity-dependencies status|install');
  const selected = manager(root);
  if (selected !== 'npm') {
    if (installed(root) || sharedReady(root, base)) return;
    throw new Error(
      `Use this project's ${selected} install command, then retry; this helper never replaces its package manager with npm.`,
    );
  }
  let currentIdentity = identity(root);
  let rootLockFd;
  let verified = false;
  const verify = async () => {
    if (!verified) {
      await packagePolicy(root, rootLockFd);
      verified = true;
    }
  };
  const ready = () => installed(root) && receiptMatches(root, identity(root));
  if (ready()) {
    await verify();
    if (action === 'install')
      console.log('Using existing compatible project dependencies; no install needed.');
    return;
  }
  if (
    sharedReady(root, base) &&
    receiptMatches(base, currentIdentity) &&
    workspaceLinksReady(root)
  ) {
    await verify();
    if (action === 'install')
      console.log('Using compatible shared project dependencies; no private install needed.');
    return;
  }
  const cacheRoot = join(common, 'verity-dependencies');
  if (action === 'status') {
    console.error(`Dependencies are not ready: ${readinessReason(root, currentIdentity)}.`);
    console.error(`Shared project: ${readinessReason(base, currentIdentity)}.`);
    console.error(
      cachedReady(root, join(cacheRoot, currentIdentity), currentIdentity)
        ? 'A complete central inventory is available; run verity dependencies install to activate it.'
        : 'No complete compatible central inventory is available; run verity dependencies install to prepare it.',
    );
    process.exitCode = 1;
    return;
  }
  if (root === base)
    throw new Error(
      'Dependency preparation requires a session worktree; the shared project installation is preserved.',
    );
  const unlockRoot = await lock(join(git('rev-parse', '--absolute-git-dir'), 'verity-npm.lock'));
  rootLockFd = unlockRoot.fd;
  let unlockIdentity;
  let preparation;
  let stage;
  let centralAttempt = false;
  let child;
  let cancelled;
  const handlers = ['SIGINT', 'SIGTERM'].map((signal) => {
    const handler = () => {
      cancelled = signal;
      child?.kill(signal);
    };
    process.on(signal, handler);
    return [signal, handler];
  });
  const checkInputs = () => {
    if (cancelled)
      throw new Error(
        `Dependency preparation interrupted (${cancelled}); no activation was published.`,
      );
    if (identity(root) !== currentIdentity)
      throw new Error(
        'Dependency inputs changed during preparation; no ready receipt was published.',
      );
  };
  try {
    await packagePolicy(root, rootLockFd, true);
    currentIdentity = identity(root);
    const waitingSince = Date.now();
    unlockIdentity = await lock(join(cacheRoot, currentIdentity + '.lock'), false);
    const waited = !unlockIdentity;
    if (waited) {
      console.log(
        'Waiting for central dependency preparation for this identity (up to 90 seconds)…',
      );
      unlockIdentity = await lock(join(cacheRoot, currentIdentity + '.lock'));
    }
    checkInputs();
    if (ready()) {
      await verify();
      return;
    }
    const modules = join(root, 'node_modules');
    const cache = join(cacheRoot, currentIdentity);
    const failure = join(cacheRoot, currentIdentity + '.failed.json');
    if (waited) {
      const failed = JSON.parse(read(failure) ?? 'null');
      if (failed?.at >= waitingSince)
        throw new Error(
          'The central dependency preparation this session waited for failed; retry explicitly after correcting the preparation error.',
        );
    }
    const preserve = () => {
      if (!readlinkExists(modules)) return;
      const recovery = join(
        git('rev-parse', '--absolute-git-dir'),
        'verity-dependencies-preserved',
        randomUUID(),
      );
      mkdirSync(dirname(recovery), { recursive: true });
      renameSync(modules, recovery);
      console.log(`Preserved previous dependency files at ${recovery}.`);
    };
    // A skeleton can use an already verified ancestor without mutating packages.
    // Shadowing private files are preserved only when a replacement is available.
    if (sharedReady(root, base, true) && receiptMatches(base, currentIdentity)) {
      await verify();
      checkInputs();
      preserve();
      restoreWorkspaceLinks(root);
      return;
    }
    const activate = async () => {
      await verify();
      checkInputs();
      const candidate = join(
        git('rev-parse', '--absolute-git-dir'),
        'verity-dependencies-copy-' + randomUUID(),
      );
      let recovery;
      try {
        cpSync(join(cache, 'node_modules'), candidate, {
          recursive: true,
          dereference: false,
          verbatimSymlinks: true,
        });
        rewire(root, candidate);
        checkInputs();
        // Validate at the final path; keep recovery files if activation ever fails.
        preserve();
        recovery = true;
        renameSync(candidate, modules);
        if (!ready()) throw new Error('Activated dependencies failed completeness validation.');
        console.log(
          'Activated compatible central dependencies; copied independent files and restored session workspace links.',
        );
      } catch (error) {
        if (recovery && readlinkExists(modules)) preserve();
        throw error;
      } finally {
        rmSync(candidate, { recursive: true, force: true });
      }
    };
    if (!cachedReady(root, cache, currentIdentity)) {
      if (!cacheable(root))
        throw new Error(
          'Central preparation requires a supported npm lockfile with project-local workspace links and no workspace-nested node_modules; no private installation was attempted.',
        );
      // Bound expensive preparation to one process per project, even across identities.
      console.log('Waiting for the central preparation slot (up to 90 seconds)…');
      preparation = await lock(join(cacheRoot, 'preparation.lock'));
      checkInputs();
      for (const entry of readdirSync(cacheRoot)) {
        if (/^[a-f0-9]{64}\.prepare$/u.test(entry))
          rmSync(join(cacheRoot, entry), { recursive: true, force: true });
      }
      centralAttempt = true;
      stage = join(cacheRoot, currentIdentity + '.prepare');
      // Only this identity owns this staging path. A native npm child inherits the
      // preparation lock, so a killed supervisor cannot race its surviving child.
      rmSync(stage, { recursive: true, force: true });
      stageInputs(root, stage);
      if (identity(root, stage) !== currentIdentity)
        throw new Error(
          'Staged dependency inputs differ from the requested identity; installation remains blocked.',
        );
      if (process.env.VERITY_SESSION_ID) {
        const runtime = await import(
          pathToFileURL(join(directory, 'verity-npm-preflight.mjs')).href
        );
        if (
          typeof runtime.npmStateDirectory !== 'function' ||
          runtime.npmStateDirectory(stage) !== join(stage, '.cache')
        )
          throw new Error(
            'Central dependency preparation requires updated sandbox package tooling; refresh the sandbox before retrying.',
          );
      }
      const prefix = spawnSync('npm', ['prefix', '--global=false'], {
        cwd: stage,
        env: npmEnvironment(),
        encoding: 'utf8',
        timeout: 15_000,
      });
      if (prefix.status !== 0 || prefix.stdout.trim() !== stage)
        throw new Error(
          'Effective npm configuration redirects installation outside central staging; no installation was attempted.',
        );
      mkdirSync(join(stage, '.cache'), { recursive: true });
      symlinkSync(join(cacheRoot, 'preparation.lock'), join(stage, '.cache', 'verity-npm.lock'));
      const stagedIdentity = stagedInputIdentity(stage);
      console.log(
        'Preparing central dependencies with npm ci; session worktrees do not download packages.',
      );
      const result = await new Promise((done, reject) => {
        child = spawn('npm', ['ci', '--ignore-scripts'], {
          cwd: stage,
          stdio: ['inherit', 'inherit', 'inherit', preparation.fd],
          env: { ...npmEnvironment(), VERITY_NPM_LOCK_FD: '3' },
        });
        child.on('error', reject);
        child.on('close', (code, signal) => done({ code, signal }));
      });
      child = undefined;
      if (cancelled || result.signal || result.code !== 0)
        throw new Error(
          `Central dependency preparation ${cancelled || result.signal ? 'interrupted' : 'failed'} (${cancelled ?? result.signal ?? result.code}); incomplete files are not reusable.`,
        );
      checkInputs();
      if (
        identity(root, stage) !== currentIdentity ||
        stagedInputIdentity(stage) !== stagedIdentity
      )
        throw new Error(
          'Dependency inputs changed during installation; no ready receipt was published.',
        );
      if (!installed(stage))
        throw new Error(
          'npm finished but required dependencies or workspace links are incomplete; installation was not marked ready.',
        );
      // Verify publication policy against the original session before making the
      // inventory available. The npm wrapper also verifies before downloading.
      await verify();
      checkInputs();
      writeFileSync(
        join(stage, 'node_modules', '.verity-install.json'),
        JSON.stringify({ identity: currentIdentity }),
      );
      const publication = await lock(join(cacheRoot, 'publication.lock'));
      try {
        if (!(await snapshotSlot(cacheRoot, currentIdentity)))
          throw new Error(
            'Central dependency inventory is full while other identities are active; retry after they finish. No private installation was attempted.',
          );
        if (readlinkExists(cache)) {
          if (read(join(cache, 'receipt.json')) !== currentIdentity)
            throw new Error(
              'Unrecognized central inventory blocks publication; existing files were preserved.',
            );
          rmSync(cache, { recursive: true });
        }
        // Temporary policy/lock files never become part of a ready inventory.
        rmSync(join(stage, '.cache', 'verity-npm.lock'));
        writeFileSync(join(stage, '.verity-inputs.sha256'), stagedIdentity);
        writeFileSync(join(stage, 'receipt.json'), currentIdentity);
        renameSync(stage, cache);
        stage = undefined;
        centralAttempt = false;
        rmSync(failure, { force: true });
      } finally {
        publication.release();
      }
      preparation.release();
      preparation = undefined;
    }
    await activate();
  } catch (error) {
    if (unlockIdentity && centralAttempt)
      writeFileSync(
        join(cacheRoot, currentIdentity + '.failed.json'),
        JSON.stringify({ at: Date.now() }),
      );
    throw error;
  } finally {
    handlers.forEach(([signal, handler]) => process.removeListener(signal, handler));
    // SIGKILL leaves staging for the next owner of the identity/preparation locks.
    if (stage) rmSync(stage, { recursive: true, force: true });
    preparation?.release();
    unlockIdentity?.release();
    unlockRoot.release();
    rootLockFd = undefined;
    if (cancelled) process.exitCode = cancelled === 'SIGINT' ? 130 : 143;
  }
}
function readlinkExists(path) {
  try {
    lstatSync(path);
    return true;
  } catch {
    return false;
  }
}
main().catch((error) => {
  console.error(error.message);
  process.exitCode ??= 1;
});
