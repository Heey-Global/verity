# Supply-chain cooldown: refuse to resolve any npm release younger than three
# days. The window matches `minimumReleaseAge: "3 days"` from the org-wide
# Renovate preset (`local>Heey-Global/.github`, extended by renovate.json), so a
# freshly compromised release is out of reach for both update paths — Renovate's
# and a manual `npm install <pkg>` — instead of only the one Renovate controls.
#
# Needs npm 11.15.0 or newer, which `engines.npm` requires and the pinned Node
# 24.19.0 supplies (npm 11.17.0). Below that the key is either unknown or does
# not survive being read from a file, and npm only warns — so an older npm
# installs exactly as if this line were absent.
#
# This affects RESOLUTION only. `npm ci` installs exactly what the lockfile
# already pins and is not filtered, so CI, image builds and deploys behave
# identically with or without this setting.
#
# To bypass it deliberately (a published security fix that must land inside the
# window): `npm install <pkg> --min-release-age=0`. Renovate does not need the
# escape hatch — renovate.json defines an empty `npmrc`, which overrides this
# file for its lockfile updates so the org's 0-day fast-track for vulnerability
# alerts still works.
min-release-age=3

# Makes the `engines` block above binding rather than advisory, and the floor
# with it: on an npm below `engines.npm` the key above is silently ignored, so
# without this npm prints one EBADENGINE warning and installs anyway — leaving a
# repository that looks protected and is not. With it npm refuses and names the
# version it wanted. It applies to dependencies' `engines` as well, so a
# transitive package that excludes the pinned Node becomes a hard failure here
# rather than a warning; `npm install --engine-strict=false` is the deliberate
# way past that while it is dealt with.
#
# Unlike the floor above, this does apply to `npm ci`. CI still passes it:
# every workflow pins Node 24.19.0, whose npm satisfies `engines.npm`. The image
# builds never see the question — none of the Dockerfiles copy this file into
# their build context, and they pin the same Node anyway.
engine-strict=true
