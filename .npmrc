# Supply-chain cooldown: refuse to resolve any npm release younger than three
# days. The window matches `minimumReleaseAge: "3 days"` from the org-wide
# Renovate preset (`local>Heey-Global/.github`, extended by renovate.json), so a
# freshly compromised release is out of reach for both update paths — Renovate's
# and a manual `npm install <pkg>` — instead of only the one Renovate controls.
#
# Needs npm 11.15.0 or newer, which `engines.npm` requires and the pinned Node
# already supplies. Below that the key is either unknown or does not survive
# being read from a file, and npm only warns — so an older npm installs exactly
# as if this line were absent.
#
# This affects RESOLUTION only. `npm ci` installs exactly what the lockfile
# already pins and is not filtered, so CI, image builds and deploys behave
# identically with or without this setting.
#
# To bypass it deliberately (a published security fix that must land inside the
# window): `npm install <pkg> --min-release-age=0`. Renovate does not need the
# escape hatch — renovate.json sets `ignoreNpmrcFile: true`, which keeps this
# floor out of its lockfile updates so the org's 0-day fast-track for
# vulnerability alerts still works.
min-release-age=3
