{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "26.11.1"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "26.11.1"
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "node": "26.11.1"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "node": "26.11.1"
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "VERITY_APP_VARIANT": "production",
        "EXPO_UPDATE_CHANNEL": "production"
      },
      "node": "26.11.1"
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "staging",
      "env": {
        "VERITY_APP_VARIANT": "staging",
        "EXPO_UPDATE_CHANNEL": "staging"
      },
      "node": "26.11.1"
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "appleTeamId": "P9C486Q6X6",
        "ascAppId": "6807746931"
      }
    }
  }
}
