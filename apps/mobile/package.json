{
  "name": "@verity/mobile-app",
  "version": "0.0.0",
  "private": true,
  "description": "Verity mobile app (Expo / React Native, Happy fork) — renders the @verity/mobile data layer. Built/run in the operator's Expo environment; this repo keeps it typecheck-green.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "REACT_NATIVE_PACKAGER_HOSTNAME=dev-server expo start --dev-client --port 8083 --clear",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage",
    "patch:native": "node ../../scripts/patch-mobile-native-deps.mjs",
    "eas-build-post-install": "npm run patch:native && cd ../.. && npm run -w @verity/mobile build"
  },
  "dependencies": {
    "@verity/mobile": "*",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.18",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-speech-recognition": "56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-updates": "~57.0.19",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "0.32.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-uitextview": "2.2.0",
    "react-native-unistyles": "3.2.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "babel-preset-expo": "~57.0.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  }
}
