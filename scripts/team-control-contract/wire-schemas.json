{
  "helloTeam": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "teamVersions": {
        "type": "array",
        "items": [
          {
            "type": "number",
            "const": 1
          }
        ],
        "additionalItems": false,
        "minItems": 1,
        "maxItems": 1
      }
    },
    "required": ["teamVersions"],
    "additionalProperties": false
  },
  "welcomeTeam": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "teamVersion": {
        "type": "number",
        "const": 1
      }
    },
    "required": ["teamVersion"],
    "additionalProperties": false
  },
  "grantGet": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "team.grant.get"
      },
      "requestId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
