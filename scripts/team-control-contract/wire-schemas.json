  "teamError": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "team.error"
      },
      "requestId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "teamVersion": {
        "type": "number",
        "const": 1
      },
      "code": {
        "type": "string",
        "enum": [
          "unsupported_version",
          "not_entitled",
          "authorization_expired",
          "revoked",
          "forbidden",
          "invitation_unavailable",
          "idempotency_conflict",
          "member_limit_reached",
          "invalid_request",
          "temporarily_unavailable",
          "internal"
        ]
      },
      "retryable": {
        "type": "boolean"
      },
      "retryAfterSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      }
    },
    "required": ["type", "requestId", "teamVersion", "code", "retryable"],
    "additionalProperties": false,
    "x-semanticChecks": ["retryAfterSecondsOnlyWhenRetryable"]
  },
  "invitationLink": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "purpose": {
        "type": "string",
        "const": "team-member"
      },
      "invitationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      },
      "secret": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "serverId": {
        "type": "string",
        "pattern": "^srv_[A-Za-z0-9_-]{21}[AQgw](?![\\s\\S])"
      },
      "identityKey": {
        "type": "string",
        "pattern": "^MCowBQYDK2VwAyEA[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      },
      "tlsPin": {
        "type": "string",
        "pattern": "^sha256-[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      },
      "coreOrigin": {
        "type": "string",
        "pattern": "^https:\\/\\/[a-z0-9.-]{1,253}(?::[0-9]{1,5})?(?![\\s\\S])"
      },
      "uplinkOrigin": {
        "type": "string",
        "pattern": "^https:\\/\\/[a-z0-9.-]{1,253}(?::[0-9]{1,5})?(?![\\s\\S])"
      },
      "installationId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "installationHandle": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{21}[AQgw](?![\\s\\S])"
      },
      "display": {
        "type": "object",
        "properties": {
          "inviterName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\p{Cc}\\u2028\\u2029]+(?![\\s\\S])"
          },
          "projectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\p{Cc}\\u2028\\u2029]+(?![\\s\\S])"
          }
        },
        "required": ["inviterName", "projectName"],
        "additionalProperties": false
      }
    },
    "required": [
      "version",
      "purpose",
      "invitationId",
      "secret",
      "expiresAt",
      "serverId",
      "identityKey",
      "tlsPin",
      "coreOrigin",
      "uplinkOrigin",
      "installationId",
