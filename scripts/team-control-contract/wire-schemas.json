    "required": ["type", "requestId", "teamVersion", "knownGeneration"],
    "additionalProperties": false
  },
  "state": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "team.state"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
          },
          "teamVersion": {
            "type": "number",
            "const": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assertion": {
            "type": "string",
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+(?![\\s\\S])"
          }
        },
        "required": ["type", "requestId", "teamVersion", "generation", "assertion"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "team.state"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
          },
          "teamVersion": {
            "type": "number",
            "const": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "suspendedReason": {
            "type": "string",
            "enum": ["not_entitled", "revoked", "authorization_expired"]
          }
        },
        "required": ["type", "requestId", "teamVersion", "generation", "suspendedReason"],
        "additionalProperties": false
      }
    ]
  },
