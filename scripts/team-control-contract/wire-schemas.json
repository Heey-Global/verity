    },
    "required": ["type", "requestId", "teamVersion"],
    "additionalProperties": false
  },
  "grant": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "team.grant"
      },
      "requestId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "teamVersion": {
        "type": "number",
        "const": 1
      },
      "assertion": {
        "type": "string",
        "maxLength": 16384,
        "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+(?![\\s\\S])"
      }
    },
    "required": ["type", "requestId", "teamVersion", "assertion"],
    "additionalProperties": false
  },
  "inviteCreate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "team.invite.create"
      },
      "requestId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "teamVersion": {
        "type": "number",
        "const": 1
      },
      "operationId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "localInviteId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
      },
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
      },
      "permissions": {
        "anyOf": [
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "const": "read"
              }
            ],
            "additionalItems": false,
            "minItems": 1,
            "maxItems": 1
          },
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "const": "read"
              },
              {
                "type": "string",
                "const": "execute"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "const": "read"
              },
              {
                "type": "string",
                "const": "manage"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "array",
            "items": [
              {
                "type": "string",
                "const": "read"
              },
              {
                "type": "string",
                "const": "execute"
              },
              {
                "type": "string",
                "const": "manage"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          }
        ]
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "bootstrapCommitment": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      },
      "installationKeyFingerprint": {
        "type": "string",
        "pattern": "^sha256-[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
      }
    },
    "required": [
      "type",
      "requestId",
      "teamVersion",
      "operationId",
      "localInviteId",
      "projectId",
      "permissions",
      "expiresAt",
      "bootstrapCommitment",
      "installationKeyFingerprint"
    ],
    "additionalProperties": false
  },
