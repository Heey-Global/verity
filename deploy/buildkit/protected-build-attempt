#!/usr/bin/python3
"""Fixed native protected-build supervisor. No project-supplied command is accepted."""
import collections
import base64
import ipaddress
import socket
import socketserver
import struct
import threading
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time

ROOT = Path('/var/lib/verity/protected-build')
TOOLS = Path('/opt/verity-egress').resolve()
LIB = Path('/usr/local/libexec/verity-buildkit')
CONFIG = TOOLS / 'protected-build-toolchain.json'
MAX_JSON = 32768
HEX = re.compile(r'[a-f0-9]{64}')


def trusted(path, directory=False):
    value = path.lstat()
    if value.st_uid != 0 or value.st_mode & 0o022 or stat.S_ISLNK(value.st_mode):
        raise ValueError('Untrusted protected build file')
    if directory != stat.S_ISDIR(value.st_mode):
        raise ValueError('Invalid protected build file type')
    return path


def load(path):
    trusted(path)
    if path.stat().st_size > MAX_JSON:
        raise ValueError('Protected build metadata too large')
    return json.loads(path.read_text())


def check():
    if os.geteuid() != 0:
        raise ValueError('Protected build requires host root')
    for tool in [TOOLS / 'node', TOOLS / 'devcontainer.js', TOOLS / 'docker-buildx',
                 LIB / 'buildkitd', LIB / 'runsc', Path('/usr/bin/docker'),
                 Path('/usr/bin/dockerd'), Path('/usr/bin/mount')]:
        trusted(tool)
    config = load(CONFIG)
    if set(config) != {'nodeFeature', 'additionalFeatures', 'nodeOptions', 'toolkitOptions'} or not isinstance(config['additionalFeatures'], list) or not config['additionalFeatures'] or config['nodeOptions'] != {'version': '26.13.0'} or config['toolkitOptions'] != {'installRunnerSupervisor': True}:
        raise ValueError('Invalid protected build release policy')
    for feature in [config['nodeFeature'], *config['additionalFeatures']]:
        if not isinstance(feature, str) or not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9._:/-]*@sha256:[a-f0-9]{64}', feature):
            raise ValueError('Unpinned protected build feature')
    return config


def write_json(path, value):
    temporary = path.with_suffix('.tmp')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def dns_answer(query, socket_path):
    """Answer only a single ordinary A/AAAA question from host-admitted records."""
    if len(query) < 12 or len(query) > 4096:
        raise ValueError('Invalid DNS query')
    txid, flags, questions, answers, authority, additional = struct.unpack('!6H', query[:12])
    if flags & 0xF800 or questions != 1 or answers or authority:
        raise ValueError('Unsupported DNS query')
    offset = 12
    labels = []
    while True:
        if offset >= len(query): raise ValueError('Invalid DNS name')
        size = query[offset]
        offset += 1
        if size == 0: break
        if size > 63 or offset + size > len(query): raise ValueError('Invalid DNS label')
        labels.append(query[offset:offset + size].decode('ascii').lower())
        offset += size
    name = '.'.join(labels)
    if len(name) > 253 or not re.fullmatch(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?', name):
        raise ValueError('Invalid DNS hostname')
    if offset + 4 > len(query): raise ValueError('Invalid DNS question')
    kind, cls = struct.unpack('!HH', query[offset:offset + 4])
    question = query[12:offset + 4]
    records = []
    ttl = 1
    if kind in (1, 28) and cls == 1:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(1)
            connection.connect(str(socket_path))
            connection.sendall(json.dumps({'name': name}).encode() + b'\n')
            response = b''
            while b'\n' not in response and len(response) <= 4096:
                block = connection.recv(4096 - len(response) + 1)
                if not block: break
                response += block
            if len(response) > 4096: raise ValueError('Oversized host DNS response')
            result = json.loads(response.split(b'\n')[0])
        if set(result) != {'addresses', 'ttlSeconds'} or not isinstance(result['addresses'], list) or len(result['addresses']) > 32 or type(result['ttlSeconds']) is not int or not 1 <= result['ttlSeconds'] <= 5:
            raise ValueError('Invalid host DNS response')
        ttl = result['ttlSeconds']
        for address in result['addresses']:
            value = ipaddress.ip_address(address)
            if (value.version == 4 and kind == 1) or (value.version == 6 and kind == 28):
                records.append(value.packed)
    payload = b''.join(b'\xc0\x0c' + struct.pack('!HHIH', kind, 1, ttl, len(value)) + value for value in records)
    return struct.pack('!6H', txid, 0x8080 | (flags & 0x0100) | (0 if records else 3), 1, len(records), 0, 0) + question + payload


def start_dns(socket_path):
    slots = threading.BoundedSemaphore(16)
    class UDP(socketserver.BaseRequestHandler):
        def handle(self):
            if not slots.acquire(blocking=False): return
            try:
                query, transport = self.request
                transport.sendto(dns_answer(query, socket_path), self.client_address)
            except (ValueError, OSError, UnicodeError):
                pass
            finally: slots.release()
    class TCP(socketserver.BaseRequestHandler):
        def handle(self):
            if not slots.acquire(blocking=False): return
            try:
                self.request.settimeout(1)
                header = self.request.recv(2)
                if len(header) != 2: return
                length = struct.unpack('!H', header)[0]
                if length > 4096: return
                query = b''
                while len(query) < length:
                    block = self.request.recv(length - len(query))
                    if not block: return
                    query += block
                answer = dns_answer(query, socket_path)
                self.request.sendall(struct.pack('!H', len(answer)) + answer)
            except (ValueError, OSError, UnicodeError):
                pass
            finally: slots.release()
    servers = [socketserver.ThreadingUDPServer(('0.0.0.0', 53), UDP), socketserver.ThreadingTCPServer(('0.0.0.0', 53), TCP)]
    for server in servers:
        server.daemon_threads = True
        threading.Thread(target=server.serve_forever, daemon=True).start()
    return servers


def run(descriptor_id):
    policy = check()
    if not HEX.fullmatch(descriptor_id):
        raise ValueError('Invalid protected build descriptor')
    directory = trusted(trusted(ROOT / 'attempts', True) / descriptor_id, True)
    metadata = load(directory / 'descriptor.json')
    if set(metadata) != {'version', 'request', 'additionalFeatures'} or metadata['version'] != 1:
        raise ValueError('Invalid protected build descriptor')
    request = metadata['request']
    if set(request) != {'projectId', 'attemptId', 'snapshot', 'image', 'noCache'}:
        raise ValueError('Invalid protected build request')
    if not re.fullmatch(r'[a-zA-Z0-9_-]{1,128}', request['projectId']) or not re.fullmatch(r'[a-f0-9-]{36}', request['attemptId']):
        raise ValueError('Invalid protected build request identity')
    import hashlib
    if hashlib.sha256((request['projectId'] + '\0' + request['attemptId']).encode()).hexdigest() != descriptor_id:
        raise ValueError('Protected build descriptor identity mismatch')
    if not re.fullmatch(r'verity-devc-[a-z0-9][a-z0-9_.-]{0,200}:[a-f0-9]{12}', request['image']) or type(request['noCache']) is not bool:
        raise ValueError('Invalid protected build image')
    feature = metadata['additionalFeatures']
    if feature not in policy['additionalFeatures']:
        raise ValueError('Unapproved protected build feature')
    workspace = trusted(directory / 'workspace', True)
    project = hashlib.sha256(request['projectId'].encode()).hexdigest()
    cache = trusted(trusted(ROOT / 'projects', True) / project, True)
    # Only the host supervisor enters this outer Docker namespace. The anchor
    # supplies identity, never a Docker socket or workload filesystem.
    expected_namespace = load(directory / 'namespace.json')
    if set(expected_namespace) != {'identity'} or os.readlink('/proc/self/ns/net') != expected_namespace['identity']:
        raise ValueError('Protected build namespace mismatch')
    runtime = directory / 'run'
    runtime.mkdir(mode=0o700, exist_ok=True)
    trusted(runtime, True)
    Path('/run/verity-buildkit').mkdir(mode=0o755, exist_ok=True)
    subprocess.run(['/usr/bin/mount', '--bind', str(runtime), '/run/verity-buildkit'], check=True, timeout=10)
    resolv = directory / 'resolv.conf'
    resolv.write_text('nameserver 127.0.0.1\noptions ndots:0\n')
    os.chmod(resolv, 0o600)
    subprocess.run(['/usr/bin/mount', '--bind', str(resolv), '/etc/resolv.conf'], check=True, timeout=10)
    subprocess.run(['/usr/bin/mount', '-o', 'remount,bind,ro', '/etc/resolv.conf'], check=True, timeout=10)
    dns_servers = start_dns(directory / 'dns.sock')
    config_dir = directory / 'docker-config'
    config_dir.mkdir(mode=0o700, exist_ok=True)
    auth = load(directory / 'registry.json') if (directory / 'registry.json').exists() else {'auths': {}}
    if set(auth) != {'auths'} or not isinstance(auth['auths'], dict) or set(auth['auths']) - {'ghcr.io'}:
        raise ValueError('Invalid protected build registry scope')
    for value in auth['auths'].values():
        if not isinstance(value, dict) or set(value) != {'auth'} or not isinstance(value['auth'], str):
            raise ValueError('Invalid protected build registry credential')
    auth['cliPluginsExtraDirs'] = [str(TOOLS)]
    write_json(config_dir / 'config.json', auth)
    env = {'PATH': str(TOOLS) + ':/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': str(config_dir),
           'DOCKER_HOST': 'unix://' + str(directory / 'docker.sock'), 'DOCKER_CONFIG': str(config_dir),
           'DOCKER_BUILDKIT': '1', 'BUILDX_BUILDER': 'verity-protected'}
    # Separate metadata daemon: image/feature resolution cannot make the host
    # Engine perform unrestricted pulls on this attempt's behalf.
    write_json(directory / 'daemon.json', {})
    dockerd = ['/usr/bin/dockerd', '--config-file', str(directory / 'daemon.json'),
               '--host', env['DOCKER_HOST'], '--data-root', str(cache / 'docker'),
               '--exec-root', str(directory / 'docker-exec'), '--pidfile', str(directory / 'docker.pid'),
               '--bridge=none', '--iptables=false', '--ip6tables=false', '--ip-forward=false',
               '--ip-masq=false', '--userland-proxy=false']
    cni = load(directory / 'cni.json')
    # The host writes a fixed CNI contract; never accept plugin executables or
    # plugin arguments from the snapshot/descriptor.
    if cni != {'cniVersion': '1.0.0', 'name': 'verity-protected-build', 'plugins': [
        {'type': 'bridge', 'bridge': 'vbki0', 'isGateway': True, 'ipMasq': True,
         'ipam': {'type': 'host-local', 'subnet': '10.215.0.0/24', 'routes': [{'dst': '0.0.0.0/0'}], 'dataDir': str(directory / 'cni-state')}},
        {'type': 'loopback'}]}:
        raise ValueError('Invalid protected build CNI contract')
    toml = ('root = ' + json.dumps(str(cache / 'buildkit')) + '\ninsecure-entitlements = []\n'
            '[grpc]\naddress = [' + json.dumps('unix://' + str(directory / 'buildkit.sock')) + ']\n'
            '[dns]\nnameservers = ["10.215.0.1"]\noptions = ["ndots:0"]\n'
            '[worker.oci]\nenabled = true\nnetworkMode = "cni"\n'
            'cniConfigPath = ' + json.dumps(str(directory / 'cni.json')) + '\n'
            'cniBinaryPath = "/usr/local/libexec/verity-buildkit/cni"\n'
            'binary = "/usr/local/libexec/verity-buildkit/runsc"\n'
            'snapshotter = "auto"\nmax-parallelism = 1\nnoProcessSandbox = false\ngc = true\n'
            '[worker.containerd]\nenabled = false\n')
    (directory / 'buildkitd.toml').write_text(toml)
    os.chmod(directory / 'buildkitd.toml', 0o600)
    children = []
    succeeded = False
    try:
        for command in [dockerd, [str(LIB / 'buildkitd'), '--config', str(directory / 'buildkitd.toml'), '--otel-socket-path', str(directory / 'otel.sock')]]:
            children.append(subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        deadline = time.monotonic() + 60
        while not (directory / 'docker.sock').is_socket() or not (directory / 'buildkit.sock').is_socket():
            if any(child.poll() is not None for child in children) or time.monotonic() > deadline:
                raise RuntimeError('Protected build daemons did not become ready')
            time.sleep(.1)
        subprocess.run(['/usr/bin/docker', 'buildx', 'create', '--name', 'verity-protected', '--driver', 'remote', 'unix://' + str(directory / 'buildkit.sock')], env=env, check=True, timeout=30, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(['/usr/bin/docker', 'buildx', 'inspect', 'verity-protected', '--bootstrap'], env=env, check=True, timeout=30, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        command = [str(TOOLS / 'node'), str(TOOLS / 'devcontainer.js'), 'build', '--workspace-folder', str(workspace), '--config', str(workspace / '.devcontainer/devcontainer.json'), '--image-name', request['image'], '--additional-features', json.dumps({policy['nodeFeature']: policy['nodeOptions'], feature: policy['toolkitOptions']}), '--output', 'type=docker,dest=' + str(directory / 'image.tar')]
        if request['noCache']:
            command.append('--no-cache')
        client = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        children.append(client)
        tail = collections.deque()
        size = 0
        while True:
            data = client.stdout.read(8192)
            if not data:
                break
            tail.append(data)
            size += len(data)
            while size > 262144 and tail:
                size -= len(tail.popleft())
        log = b''.join(tail)
        for credential in auth['auths'].values():
            encoded = credential['auth'].encode()
            log = log.replace(encoded, b'[redacted]')
            try:
                decoded = base64.b64decode(encoded, validate=True)
                for secret in [decoded, decoded.partition(b':')[2]]:
                    if secret: log = log.replace(secret, b'[redacted]')
            except ValueError:
                pass
        (directory / 'build.log').write_bytes(log)
        os.chmod(directory / 'build.log', 0o600)
        if client.wait() != 0:
            raise RuntimeError('Protected devcontainer build failed')
        trusted(directory / 'image.tar')
        succeeded = True
    finally:
        for child in reversed(children):
            if child.poll() is None:
                child.terminate()
        for child in reversed(children):
            try:
                child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait(timeout=5)
        # Daemon child exit is not cgroup end proof. The host checks the entire
        # unit before exporting this archive or releasing packet authority.
        write_json(directory / 'result.json', {'version': 1, 'state': 'succeeded' if succeeded else 'failed'})
        for server in dns_servers:
            server.shutdown()
            server.server_close()
        for secret in [directory / 'registry.json', config_dir / 'config.json']:
            secret.unlink(missing_ok=True)
    if not succeeded:
        raise RuntimeError('Protected build failed')


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['check']:
            check()
        elif len(sys.argv) == 3 and sys.argv[1] == 'run':
            run(sys.argv[2])
        else:
            raise ValueError('Invalid protected build operation')
    except Exception:
        # Root-owned bounded build.log carries detail; public status stays fixed.
        print('Protected build attempt failed', file=sys.stderr)
        sys.exit(1)
