# Experimental fixture unit; not installed by verity-install.
[Unit]
Description=Verity project network host controller
Requires=verity-egress-bootstrap.service docker.service
After=verity-egress-bootstrap.service docker.service

[Service]
Type=simple
User=root
Group=verity-egress-control
StateDirectory=verity-egress
StateDirectoryMode=0700
RuntimeDirectory=verity-egress
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --exclusive --nonblock /var/lib/verity-egress/service.lock /usr/bin/node /opt/verity-egress/project-egress-host-main.mjs serve
Restart=on-failure
RestartSec=1
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/verity-egress /run/verity-egress
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
