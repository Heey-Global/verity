#!/nodejs/bin/node

// Deliberately echoes the fixture secret on both streams. The live E2E must prove that the worker
// redacts both copies before any frame crosses the sandbox boundary.
const token = process.env.API_TOKEN;
if (typeof token !== 'string' || token.length === 0) {
  process.stderr.write('fake pilot missing API_TOKEN\n');
  process.exitCode = 2;
} else {
  process.stdout.write(`pilot-stdout:${token}:complete\n`);
  process.stderr.write(`pilot-stderr:${token}:complete\n`);
}
