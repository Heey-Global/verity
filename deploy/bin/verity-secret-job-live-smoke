#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
deploy_dir="$(cd -- "$script_dir/.." && pwd)"
# shellcheck source=../gvisor/versions.env
source "$deploy_dir/gvisor/versions.env"

source_image="${1:-verity-secret-job-fake-pilot:smoke}"
suffix="${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-0}-$$"
registry="verity-secret-job-registry-$suffix"
registry_image='registry:2.8.3@sha256:46faa9a1ae6813194b53921a370f2f4f8c5e1aae228a89bceafef5847a6a3278'
registry_ref=''
digest_ref=''

cleanup() {
  docker rm -f "$registry" >/dev/null 2>&1 || true
  [[ -z "$digest_ref" ]] || docker image rm -f "$digest_ref" >/dev/null 2>&1 || true
  [[ -z "$registry_ref" ]] || docker image rm -f "$registry_ref" >/dev/null 2>&1 || true
}
trap cleanup EXIT

expected_path="/opt/verity/runsc/$RUNSC_RELEASE/runsc"
expected_args='["--platform=systrap","--network=none"]'
runtime_registration="$(docker info --format '{{json .Runtimes.runsc}}')"
runtime_path="$(jq --raw-output '.path // empty' <<<"$runtime_registration")"
runtime_args="$(jq --compact-output '.runtimeArgs // empty' <<<"$runtime_registration")"
[[ "$runtime_path" == "$expected_path" ]] || {
  echo "runsc path mismatch: expected $expected_path, got ${runtime_path:-<missing>}" >&2
  exit 1
}
[[ "$runtime_args" == "$expected_args" ]] || {
  echo "runsc args mismatch: expected $expected_args, got ${runtime_args:-<missing>}" >&2
  exit 1
}

docker run -d --name "$registry" -p 127.0.0.1::5000 "$registry_image" >/dev/null
registry_port="$(docker inspect -f '{{(index (index .NetworkSettings.Ports "5000/tcp") 0).HostPort}}' "$registry")"
registry_ref="127.0.0.1:${registry_port}/verity/secret-job-fake-pilot:smoke"
docker tag "$source_image" "$registry_ref"
for attempt in $(seq 1 30); do
  if docker push "$registry_ref" >/dev/null 2>&1; then
    break
  fi
  if [[ "$attempt" -eq 30 ]]; then
    docker logs "$registry" >&2 || true
    echo 'local registry did not become ready' >&2
    exit 1
  fi
  sleep 0.1
done
digest_ref="$(docker inspect -f '{{index .RepoDigests 0}}' "$registry_ref")"
[[ "$digest_ref" == *@sha256:* ]]

node packages/server/dist/secret-job-live-smoke.js "$digest_ref"
