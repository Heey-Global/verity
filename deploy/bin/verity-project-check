#!/bin/bash
# Read-only health check of every running Verity project Sandbox: what an agent inside one needs
# (DNS, HTTPS, npm, git, its relay, the Runner supervisor, a writable workspace). Changes nothing.
# Exits non-zero when any check fails. Run as root on the Verity host:
#   sudo deploy/bin/verity-project-check
set -u
failures=0
ok() { printf '  OK    %s\n' "$*"; }
bad() {
  printf '  FAIL  %s\n' "$*"
  failures=$((failures + 1))
}
run() { # label, container, user, command...
  local label=$1 c=$2 u=$3; shift 3
  local out
  if out=$(timeout 30 docker exec -u "$u" "$c" "$@" 2>&1); then ok "$label${out:+ — ${out//$'\n'/ | }}"
  else bad "$label — ${out//$'\n'/ | }"; fi
}
node_check() { # label, container, js
  run "$1" "$2" 1000:1000 node -e "$3"
}

echo "Host: Docker $(docker version --format '{{.Server.Version}}'), runtimes: $(docker info --format '{{range $k,$v := .Runtimes}}{{$k}} {{end}}')"
mapfile -t sandboxes < <(docker ps --filter label=verity.project-id --format '{{.Names}}' |
  while read -r n; do
    [ "$(docker inspect -f '{{index .Config.Labels "verity.component"}}' "$n")" = project-relay ] || echo "$n"
  done)
[ "${#sandboxes[@]}" -gt 0 ] || { echo 'no running project Sandbox found'; exit 1; }

for c in "${sandboxes[@]}"; do
  project=$(docker inspect -f '{{index .Config.Labels "verity.project-id"}}' "$c")
  echo
  echo "== $c (project $project, runtime $(docker inspect -f '{{.HostConfig.Runtime}}' "$c"))"
  relay=$(docker ps --filter "label=verity.project-id=$project" --filter label=verity.component=project-relay --format '{{.Names}}' | head -n1)
  echo "  relay: ${relay:-none}"
  echo "  resolv.conf: $(docker exec "$c" cat /etc/resolv.conf 2>&1 | grep -v '^#' | tr '\n' ' ')"
  node_check 'DNS registry.npmjs.org' "$c" "require('dns').lookup('registry.npmjs.org',(e,a)=>{if(e){console.log(e.code);process.exit(1)}console.log(a)})"
  node_check 'DNS github.com' "$c" "require('dns').lookup('github.com',(e,a)=>{if(e){console.log(e.code);process.exit(1)}console.log(a)})"
  node_check 'HTTPS registry.npmjs.org' "$c" "fetch('https://registry.npmjs.org/-/ping').then(r=>{console.log(r.status);process.exit(r.ok?0:1)},e=>{console.log(e.cause?.code??e.message);process.exit(1)})"
  node_check 'HTTPS github.com' "$c" "fetch('https://github.com',{method:'HEAD'}).then(r=>{console.log(r.status)},e=>{console.log(e.cause?.code??e.message);process.exit(1)})"
  run 'npm registry (npm view)' "$c" 1000:1000 sh -c 'command -v npm >/dev/null || { echo "npm not installed"; exit 0; }; out=$(npm view left-pad version --prefer-online 2>&1) || { echo "$out" | tail -n3; exit 1; }; echo "$out"'
  run 'git over HTTPS (ls-remote)' "$c" 1000:1000 sh -c 'command -v git >/dev/null || { echo "git not installed"; exit 0; }; out=$(git ls-remote https://github.com/octocat/Hello-World.git HEAD 2>&1) || { echo "$out"; exit 1; }; echo "$out" | cut -c1-12'
  if [ -n "$relay" ]; then
    node_check "relay $relay:8080 reachable" "$c" "const s=require('net').connect(8080,'$relay',()=>{console.log('connected');s.end()});s.on('error',e=>{console.log(e.code);process.exit(1)});s.setTimeout(5000,()=>{console.log('timeout');process.exit(1)})"
  fi
  run 'Runner supervisor probe' "$c" 1101:1101 env VERITY_RUNNER_RUNTIME=/run/verity-runner verity-runner-supervisor --probe
  run 'workspace writable' "$c" 1000:1000 sh -c 'd=$(pwd); [ "$d" = / ] && d=${HOME:-/tmp}; f=$(mktemp -p "$d" .verity-check.XXXXXX) && rm -f "$f" && echo "$d"'
done

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures check(s) failed"
  exit 1
fi
echo 'all checks passed'
