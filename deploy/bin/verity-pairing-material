#!/usr/bin/env bash
set -euo pipefail

state_dir="${VERITY_STATE_DIR:-/etc/verity}"
port="${VERITY_API_HOST_PORT:-8082}"
identity_key="$state_dir/pairing-identity.pem"
tls_key="$state_dir/tls-key.pem"
tls_cert="$state_dir/tls-cert.pem"
tls_ca_key="$state_dir/tls-ca-key.pem"
tls_ca_cert="$state_dir/tls-ca-cert.pem"
pairing_code="$state_dir/pairing-code"
pairing_expiry="$state_dir/pairing-expires-at"
pairing_uri="$state_dir/pairing-uri"
server_uid="${VERITY_SERVER_UID:-1000}"
server_gid="${VERITY_SERVER_GID:-1000}"

die() { printf 'verity-pairing-material: %s\n' "$*" >&2; exit 1; }
command -v openssl >/dev/null 2>&1 || die 'openssl is required'
[[ "$server_uid" =~ ^[0-9]+$ ]] || die 'VERITY_SERVER_UID must be decimal digits'
[[ "$server_gid" =~ ^[0-9]+$ ]] || die 'VERITY_SERVER_GID must be decimal digits'
[ -d "$state_dir" ] || die "$state_dir does not exist"
[ ! -L "$state_dir" ] || die "$state_dir must not be a symlink"
if [ "$(id -u)" = 0 ]; then
  [ "$(stat -c '%u' "$state_dir")" = 0 ] || die "$state_dir must be owned by root"
  # The non-root Server needs traversal, while material files below remain 0600.
  chmod 0711 "$state_dir"
fi

for material in "$identity_key" "$tls_key" "$tls_cert" "$tls_ca_key" "$tls_ca_cert" "$pairing_code" "$pairing_expiry" "$pairing_uri"; do
  [ ! -L "$material" ] || die "$material must not be a symlink"
  [ ! -e "$material" ] || [ -f "$material" ] || die "$material must be a regular file"
done

write_private() {
  local target="$1"
  local temporary="$target.$$.tmp"
  umask 077
  cat >"$temporary"
  chmod 0600 "$temporary"
  if [ "$(id -u)" = 0 ]; then chown "$server_uid:$server_gid" "$temporary"; fi
  mv -f "$temporary" "$target"
}

write_root_private() {
  local target="$1"
  local temporary="$target.$$.tmp"
  umask 077
  cat >"$temporary"
  chmod 0600 "$temporary"
  if [ "$(id -u)" = 0 ]; then chown root:root "$temporary"; fi
  mv -f "$temporary" "$target"
}

if [ ! -s "$identity_key" ]; then
  openssl genpkey -algorithm ED25519 | write_private "$identity_key"
fi
had_ca_chain=false
if [ -s "$tls_ca_key" ] && [ -s "$tls_ca_cert" ]; then had_ca_chain=true; fi
# The CA file is the format marker. Migrate once by rotating the former
# self-signed leaf key instead of carrying its pin into the CA-based protocol.
if [ "$had_ca_chain" = false ]; then
  openssl ecparam -name prime256v1 -genkey -noout | write_private "$tls_key"
elif [ ! -s "$tls_key" ]; then
  openssl ecparam -name prime256v1 -genkey -noout | write_private "$tls_key"
fi
renew_ca=false
ca_key_digest=''
ca_cert_digest=''
if [ "$had_ca_chain" = true ]; then
  ca_key_digest="$(openssl pkey -in "$tls_ca_key" -pubout -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null || true)"
  ca_cert_digest="$(openssl x509 -in "$tls_ca_cert" -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null || true)"
fi
if [ "$had_ca_chain" = false ] \
  || [ -z "$ca_key_digest" ] \
  || [ "$ca_key_digest" != "$ca_cert_digest" ] \
  || ! openssl x509 -in "$tls_ca_cert" -noout -text 2>/dev/null | grep -q 'CA:TRUE' \
  || ! openssl x509 -in "$tls_ca_cert" -noout -checkend $((397 * 86400)) >/dev/null 2>&1; then
  renew_ca=true
fi
if [ "$renew_ca" = true ]; then
  openssl ecparam -name prime256v1 -genkey -noout | write_root_private "$tls_ca_key"
  ca_temporary="$tls_ca_cert.$$.tmp"
  openssl req -new -x509 -sha256 -days 3650 -key "$tls_ca_key" -out "$ca_temporary" \
    -subj '/CN=Verity local pairing CA' \
    -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
    -addext 'keyUsage=critical,keyCertSign,cRLSign'
  chmod 0644 "$ca_temporary"
  if [ "$(id -u)" = 0 ]; then chown root:root "$ca_temporary"; fi
  mv -f "$ca_temporary" "$tls_ca_cert"
fi
if [ "$(id -u)" = 0 ]; then
  chown "$server_uid:$server_gid" "$identity_key" "$tls_key"
  chown root:root "$tls_ca_key"
fi
chmod 0600 "$identity_key" "$tls_key" "$tls_ca_key"
chmod 0644 "$tls_ca_cert"

ips="${VERITY_PAIRING_IPS:-$(hostname -I 2>/dev/null || true)}"
san='DNS:localhost,IP:127.0.0.1'
suggested=''
for ip in $ips; do
  case "$ip" in
    *:*|*[!0-9.]*) continue ;;
  esac
  san="$san,IP:$ip"
  [ -n "$suggested" ] || suggested="https://$ip:$port"
done
pair_host="${VERITY_PAIRING_HOST:-}"
if [ -n "$pair_host" ]; then
  [[ "$pair_host" =~ ^[A-Za-z0-9.-]+$ ]] || die 'VERITY_PAIRING_HOST is not an IPv4 address or DNS name'
  if [[ "$pair_host" =~ ^[0-9.]+$ ]]; then
    [[ "$pair_host" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] \
      || die 'VERITY_PAIRING_HOST is not a valid IPv4 address'
    IFS=. read -r a b c d <<<"$pair_host"
    [ "$a" -le 255 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ] \
      || die 'VERITY_PAIRING_HOST is not a valid IPv4 address'
    san="$san,IP:$pair_host"
  else
    [[ "$pair_host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
      || die 'VERITY_PAIRING_HOST is not a valid DNS name'
    [ "${#pair_host}" -le 253 ] || die 'VERITY_PAIRING_HOST is not a valid DNS name'
    IFS=. read -ra dns_labels <<<"$pair_host"
    for label in "${dns_labels[@]}"; do
      [ -n "$label" ] && [ "${#label}" -le 63 ] \
        && [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] \
        || die 'VERITY_PAIRING_HOST is not a valid DNS name'
    done
    san="$san,DNS:$pair_host"
  fi
  suggested="https://$pair_host:$port"
fi
[ -n "$suggested" ] || suggested="https://127.0.0.1:$port"

# Once on the CA-based format, retain a bounded set of prior endpoints so a host
# change does not strand paired devices. Legacy self-signed SANs are deliberately
# ignored during the one-time clean break above.
if [ "$had_ca_chain" = true ] && [ -s "$tls_cert" ]; then
  retained_sans=0
  while IFS= read -r existing_san; do
    [ -n "$existing_san" ] || continue
    [ "$retained_sans" -lt 16 ] || break
    existing_san="${existing_san/IP Address:/IP:}"
    case ",$san," in
      *",$existing_san,"*) ;;
      *) san="$san,$existing_san"; retained_sans=$((retained_sans + 1)) ;;
    esac
  done <<<"$(openssl x509 -in "$tls_cert" -noout -ext subjectAltName 2>/dev/null \
    | grep -oE 'DNS:[A-Za-z0-9.-]+|IP Address:[0-9.]+' || true)"
fi

# Reissue the leaf certificate so a newly selected IP or DNS name is always in
# its SANs. The stable TLS key keeps the public-key pin unchanged for paired apps.
temporary="$tls_cert.$$.tmp"
csr_temporary="$tls_cert.$$.csr.tmp"
extensions_temporary="$tls_cert.$$.ext.tmp"
trap 'rm -f "$temporary" "$csr_temporary" "$extensions_temporary"' EXIT
openssl req -new -sha256 -key "$tls_key" -out "$csr_temporary" \
  -subj '/CN=Verity local control plane'
printf '%s\n' \
  "subjectAltName=$san" \
  'basicConstraints=critical,CA:FALSE' \
  'keyUsage=digitalSignature,keyEncipherment' \
  'extendedKeyUsage=serverAuth' >"$extensions_temporary"
openssl x509 -req -sha256 -days 397 -in "$csr_temporary" \
  -CA "$tls_ca_cert" -CAkey "$tls_ca_key" \
  -set_serial "0x$(openssl rand -hex 16)" \
  -extfile "$extensions_temporary" -out "$temporary"
cat "$tls_ca_cert" >>"$temporary"
chmod 0644 "$temporary"
if [ "$(id -u)" = 0 ]; then chown root:root "$temporary"; fi
mv -f "$temporary" "$tls_cert"
rm -f "$csr_temporary" "$extensions_temporary"
trap - EXIT

code="$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
expires_at="$(date -u -d '+15 minutes' '+%Y-%m-%dT%H:%M:%S.000Z')"
printf %s "$code" | write_private "$pairing_code"
printf %s "$expires_at" | write_private "$pairing_expiry"

identity_key_b64="$(openssl pkey -in "$identity_key" -pubout -outform DER | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
server_id="srv_$(printf 'verity.device-pairing.v1.server-id\0%s' "$identity_key_b64" | openssl dgst -sha256 -binary | head -c 16 | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
# Pin the P-256 public key rather than the leaf certificate. The TLS key remains
# stable when the short-lived self-signed certificate renews, so paired devices
# keep working without accepting an unrelated certificate/key.
tls_pin="sha256-$(openssl x509 -in "$tls_cert" -pubkey -noout | openssl pkey -pubin -outform DER | tail -c 65 | openssl dgst -sha256 -binary | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
payload="$(printf '{"v":1,"serverId":"%s","identityKey":"%s","tlsPin":"%s","code":"%s","url":"%s","expiresAt":"%s"}' "$server_id" "$identity_key_b64" "$tls_pin" "$code" "$suggested" "$expires_at" | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
printf 'verity://pair?payload=%s' "$payload" | write_private "$pairing_uri"

cat "$pairing_uri"
printf '\n'
