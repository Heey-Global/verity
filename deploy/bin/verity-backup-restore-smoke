#!/usr/bin/env bash
# Full capture and installer recovery on separate disposable Docker hosts.
set -euo pipefail
image=${1:?usage: verity-backup-restore-smoke <server-image> <daemon-fixture-image> <image-archive>}
fixture_image=${2:?daemon fixture image required}
archive=${3:?server image archive required}
: "${GITHUB_RUN_ID:?CI run identity required}"
: "${GITHUB_RUN_ATTEMPT:?CI attempt required}"
: "${RUNNER_TEMP:?private CI temporary directory required}"
outer=unix:///var/run/docker.sock
work=$(mktemp -d "$RUNNER_TEMP/verity-backup-restore.XXXXXXXX")
chmod 0700 "$work"
prefix="verity-backup-restore-dind-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
original="$prefix-original"
fresh="$prefix-fresh"
first_fresh=$fresh
second="$prefix-second"
root=/opt/verity-restore-fixture
repo=ghcr.io/heey-global/verity/verity-server
registry=registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
host_docker() { docker --host "$outer" "$@"; }
inside() { host_docker exec --env DOCKER_HOST=unix:///var/run/docker.sock "$daemon_name" "$@"; }
inner() { docker --host "$socket" "$@"; }
cleanup() {
  local status=$?
  trap - EXIT
  # Never print the private input or installer output, even on an assertion failure.
  for name in "$original" "$first_fresh" "$second"; do
    host_docker rm -f "$name" >/dev/null 2>&1 || true
    host_docker volume rm "$name-data" >/dev/null 2>&1 || true
  done
  rm -rf -- "$work"
  exit "$status"
}
trap cleanup EXIT
start_host() {
  daemon_name=$1
  [[ $daemon_name = "$original" || $daemon_name = "$fresh" || $daemon_name = "$second" ]]
  local socket_dir="$work/${daemon_name##*-}"
  mkdir -m 0700 "$socket_dir"
  socket="unix://$socket_dir/docker.sock"
  host_docker volume create "$daemon_name-data" >/dev/null
  host_docker run --detach --privileged --name "$daemon_name" --add-host ghcr.io:127.0.0.1 \
    --volume "$socket_dir:$socket_dir" --mount "type=volume,src=$daemon_name-data,dst=/var/lib/docker" \
    --env DOCKER_TLS_CERTDIR= "$fixture_image" --host=unix:///var/run/docker.sock \
    --host="unix://$socket_dir/docker.sock" --insecure-registry ghcr.io >/dev/null
  for attempt in $(seq 1 120); do
    if inside docker info >/dev/null 2>&1; then break; fi
    [[ $attempt != 120 ]] || { host_docker logs "$daemon_name" >&2; echo 'restore fixture daemon did not start' >&2; exit 1; }
    sleep 0.25
  done
  inside chmod 0666 "$socket_dir/docker.sock"
  daemon_id=$(inner info --format '{{.ID}}')
  [[ -n $daemon_id && $daemon_id != "$(host_docker info --format '{{.ID}}')" ]]
  [[ $daemon_id = "$(inside docker info --format '{{.ID}}')" ]]
  [[ -z $(inner ps -aq) && -z $(inner volume ls -q) ]]
  inner load --input "$archive" >/dev/null
  inner run -d --name restore-registry --publish 80:5000 --publish 443:5000 "$registry" >/dev/null
  for attempt in $(seq 1 120); do
    if inside curl --fail --silent http://127.0.0.1/v2/ >/dev/null; then break; fi
    [[ $attempt != 120 ]] || exit 1
    sleep 0.25
  done
  inner tag "$image" "$repo:restore-acceptance"
  inner push --quiet "$repo:restore-acceptance" >/dev/null
  digest=$(inner image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$repo:restore-acceptance" | awk -v prefix="$repo@sha256:" 'index($0,prefix)==1 {print;exit}')
  [[ $digest =~ ^ghcr.io/heey-global/verity/verity-server@sha256:[a-f0-9]{64}$ ]]
  inner pull --quiet "$digest" >/dev/null
  inside mkdir -p "$root"
  host_docker cp "$repo_root/.github/scripts/backup-restore-docker.mjs" "$daemon_name:$root/driver.mjs"
  host_docker cp "$repo_root/.github/scripts/backup-restore-diagnostics.mjs" "$daemon_name:$root/backup-restore-diagnostics.mjs"
  host_docker cp "$repo_root/scripts/backup-restore-content.mjs" "$daemon_name:$root/backup-restore-content.mjs"
  host_docker cp "$repo_root/.github/scripts/backup-restore-device-trust.mjs" "$daemon_name:$root/backup-restore-device-trust.mjs"
}
run_driver() {
  local action=$1 fault=${2:-} job='' phase=''
  local -a mounts=(--mount "type=bind,src=$root,dst=$root")
  if [[ $action = destination-full ]]; then
    mounts+=(--mount "type=tmpfs,dst=$root/enospc,tmpfs-size=4194304,tmpfs-mode=0700")
  fi
  if [[ $action != capture && $action != diagnose-activation && $action != monitor-activation ]]; then
    if [[ $action != late-revoke ]]; then mounts+=(--mount "type=bind,src=$root/backup,dst=$root/backup,readonly"); fi
    if [[ $action = no-space ]]; then mounts+=(--mount "type=tmpfs,dst=$root/host/restore,tmpfs-size=33554432,tmpfs-mode=0700"); fi
    if inside test -f "$root/host/restore/job"; then
      job=$(inside jq -r .id "$root/host/restore/job")
      phase=$(inside jq -r .phase "$root/host/restore/job")
    fi
    if [[ $phase =~ ^(promoted|accepting|accepted)$ ]]; then
      inner volume inspect verity-data >/dev/null
      mounts+=(--mount type=volume,src=verity-data,dst=/restore-live --mount type=volume,src=verity-data,dst=/srv/verity)
    fi
  fi
  # Keep the driver out of PID 1 so self-SIGKILL exercises a real abrupt exit.
  inner run --rm --init --user 0:0 --network host --label "verity.restore-job=$job" \
    --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock "${mounts[@]}" \
    --env VERITY_RESTORE_DOCKER_ACCEPTANCE=1 --env "VERITY_RESTORE_TEST_DAEMON_ID=$daemon_id" \
    --env "VERITY_RESTORE_ENABLED_IMAGE=${enabled_digest:-}" --env "VERITY_RESTORE_TEST_IMAGE=$digest" --env "VERITY_RESTORE_TEST_INTERRUPT=$fault" \
    --env "VERITY_RESTORE_TEST_NEW_IDENTITY=${new_identity:-0}" \
    --entrypoint node "$digest" "$root/driver.mjs" "$action"
}
expect_interruption() {
  local effect=$1 status
  set +e
  run_driver advance "$effect" >"$work/interruption.log" 2>&1
  status=$?
  set -e
  if [[ $status != 137 ]]; then
    sed -n '/^Restore fixture failure: /p' "$work/interruption.log" >&2
    echo "expected process interruption during $effect, got $status" >&2
    exit 1
  fi
}
prepare_reviewed() {
  run_driver begin
  for step in 1 2 3; do run_driver advance; done
  run_driver wrong-password
  sleep 6
  if [[ ${trial_surfaces_checked:-0} = 0 ]]; then
    run_driver trial-surfaces
    trial_surfaces_checked=1
    sleep 6
  fi
  run_driver review
  run_driver advance
}

start_host "$original"
original_id=$daemon_id
original_digest=$digest
run_driver capture
echo '--- recovery: actual ENOSPC on a private destination'
run_driver destination-full
mkdir -m 0700 "$work/copied"
host_docker cp "$original:$root/backup" "$work/copied/backup"
host_docker cp "$original:$root/input" "$work/copied/input"
# This tiny intentionally unsupported image represents a downloadable historical release.
host_docker cp "$original:$root/unsupported-release.tar" "$work/unsupported-release.tar"
# This deletes the source database, source projects, original identity and local deduplication index.
host_docker rm -f "$original" >/dev/null
host_docker volume rm "$original-data" >/dev/null
start_host "$fresh"
[[ $daemon_id != "$original_id" && $digest = "$original_digest" ]]
host_docker cp "$work/copied/." "$fresh:$root"
inner load --input "$work/unsupported-release.tar" >/dev/null
inner push --quiet "$repo:restore-unsupported" >/dev/null
inside test ! -e "$root/original"
inside test ! -e "$root/original-index"

run_driver seed-compose

echo '--- recovery: wrong recovery key and retry'
run_driver begin
run_driver wrong-key
run_driver abort
echo '--- recovery: unauthenticated historical release and snapshot rejection'
run_driver begin
run_driver bad-release
run_driver abort
run_driver begin
# Damage only the copied snapshot, then restore its bytes before retrying.
snapshot="$root/backup/repositories/$(inside jq -r .repository "$root/input")/snapshots/$(inside jq -r .sequence "$root/input")-manual"
[[ -n $snapshot ]]
inside cp "$snapshot" "$root/snapshot-original"
inside sh -c 'printf tampered > "$1"' sh "$snapshot"
run_driver rejected-snapshot
inside cp "$root/snapshot-original" "$snapshot"
run_driver abort
# The verification root is a genuinely constrained filesystem, below its 64 MiB reserve.
run_driver no-space
run_driver unsupported
run_driver abort

echo '--- recovery: copied revocation history missing requires explicit review'
inside mv "$root/backup/revocations" "$root/revocations-held"
run_driver begin
for step in 1 2 3; do run_driver advance; done
run_driver inspect-missing-history
run_driver abort
inside mv "$root/revocations-held" "$root/backup/revocations"

echo '--- recovery: actual process interruption after each preparation transition'
for effect in verify stage trial review; do
  run_driver begin
  case "$effect" in
    verify) ;;
    stage) run_driver advance ;;
    trial) run_driver advance; run_driver advance ;;
    review) run_driver advance; run_driver advance; run_driver advance; run_driver review ;;
  esac
  expect_interruption "$effect"
  run_driver advance
  run_driver abort
done
echo '--- recovery: interrupted publication and abort restore only owned resources'
prepare_reviewed
expect_interruption promote
run_driver abort
run_driver assert-aborted

echo '--- recovery: preserved identity, master authentication and restart-safe acceptance'
prepare_reviewed
run_driver late-revoke
expect_interruption promote
run_driver advance
run_driver assert-restored
expect_interruption accept
run_driver advance
expect_interruption initialize

activate_installer() {
  local payload monitor status=0
  inside mkdir -p /opt/verity-install
  payload=$(inner create "$digest")
  inner cp "$payload:/opt/verity-install/." - | host_docker exec -i "$fresh" tar -xf - -C /opt/verity-install
  inner rm "$payload" >/dev/null
  inside rm -f "$root/activation-monitor-stop"
  # Capture safe summaries before managed-up removes an unhealthy candidate during rollback.
  run_driver monitor-activation >"$work/activation-diagnostics.log" 2>&1 &
  monitor=$!
  inside sh -c 'date +%s000 > "$1/restored-schedule-start"' sh "$root"
  # The real bundled installer consumes the supplied keys on stdin and performs normal deployment activation.
  inside jq -r '.recoveryKey,.masterPassword' "$root/input" \
    | host_docker exec -i --env DOCKER_HOST=unix:///var/run/docker.sock --env "VERITY_STATE_DIR=$root/host" \
        --env VERITY_API_HOST_PORT=0 --env VERITY_PAIRING_HOST=127.0.0.1 "$fresh" \
        sh -c 'umask 077; exec /opt/verity-install/deploy/bin/verity-install --image "$1" --restore "$2/backup" --restore-action accept --restore-secrets-stdin >"$2/install.log" 2>&1' sh "$digest" "$root" || status=$?
  inside touch "$root/activation-monitor-stop"
  wait "$monitor" || true
  if [[ $status != 0 ]]; then
    sed -n '/^Restore .* diagnostic: /p' "$work/activation-diagnostics.log" >&2
    run_driver diagnose-activation >&2 || true
    return "$status"
  fi
}
activate_installer
run_driver verify-api

run_driver verify-restored-schedule
run_driver assert-prerequisites
build_test_image() {
inside mkdir -p "$root/enabled-build"
host_docker exec -i "$fresh" sh -c 'cat >"$1/Dockerfile"' sh "$root/enabled-build" <<'DOCKERFILE'
ARG BASE
FROM ${BASE}
USER 0
# Test-only diagnostics preserve control flow and report only static source error literals/codes.
RUN node --input-type=module -e 'import {readFileSync,writeFileSync,readdirSync} from "node:fs"; const root="/app/packages/server/dist/backup/"; const files=readdirSync(root).filter(n=>n.endsWith(".js")); const safe=files.flatMap(n=>[...readFileSync(root+n,"utf8").matchAll(/new Error\((["\x27])([^"\x27\\]*?)\1\)/g)].map(m=>m[2])); const report="console.error(\"BACKUP_ACCEPTANCE_FAILURE \"+JSON.stringify({name:error?.name,code:/^[A-Z0-9_]{1,30}$/.test(error?.code)?error.code:undefined,message:"+JSON.stringify(safe)+".includes(error?.message)?error.message:undefined}));"; for(const [name,before,after] of [["scheduler.js","catch {","catch (error) {"+report],["runtime.js","catch (error) {","catch (error) {"+report],["identity-request.js","// A previous attempt","console.error(\"BACKUP_ACCEPTANCE_IDENTITY \"+JSON.stringify({code:error?.code,mismatch:error?.message===\"Identity helper receipt does not match this capture\"})); // A previous attempt"]]) {const p=root+name;const s=readFileSync(p,"utf8");if(s.split(before).length!==2)throw Error("diagnostic patch mismatch");writeFileSync(p,s.replace(before,after));}'
USER 1000:1000
DOCKERFILE
inside docker build --quiet --build-arg "BASE=$digest" --tag "$repo:backup-enabled-acceptance" "$root/enabled-build" >/dev/null
inner push --quiet "$repo:backup-enabled-acceptance" >/dev/null
enabled_digest=$(inner image inspect --format '{{index .RepoDigests 0}}' "$repo:backup-enabled-acceptance")
[[ $enabled_digest =~ ^ghcr.io/heey-global/verity/verity-server@sha256:[a-f0-9]{64}$ && $enabled_digest != "$digest" ]]
}
install_test_image() {
  local target=$1 status=0
  # Fixture-only offline preparation: paired installations correctly reject arbitrary image repair.
  # Stop writers and bind the isolated authority to the exact unpublished test digest.
  mapfile -t test_writers < <(inner ps -q --filter label=com.docker.compose.service=verity-updater)
  [[ ${#test_writers[@]} = 1 ]]
  inner stop "${test_writers[@]}" >/dev/null
  [[ $(inner inspect --format '{{.State.Running}}' "${test_writers[0]}") = false ]]
  inner rm -f verity-managed-server >/dev/null
  inner run --rm --user 0:0 --mount type=volume,src=verity-managed-deployment,dst=/authority \
    --entrypoint node "$digest" --input-type=module -e '
      import assert from "node:assert/strict";
      import {readFile,writeFile,rename,stat,chown} from "node:fs/promises";
      import {parseServerDeploymentSpec,sealDeploymentSpec} from "/app/packages/server/dist/self-update/deployment-spec.js";
      const path="/authority/server-deployment.json";
      const owner=await stat(path);
      const spec=parseServerDeploymentSpec(JSON.parse(await readFile(path,"utf8")));
      assert.ok(spec);
      const {checksum,...body}=spec;
      assert.match(process.argv[1], /^ghcr\.io\/heey-global\/verity\/verity-server@sha256:[a-f0-9]{64}$/);
      await writeFile(path+".fixture",JSON.stringify(sealDeploymentSpec({...body,image:process.argv[1]})),{mode:0o600});
      await chown(path+".fixture",owner.uid,owner.gid);
      await rename(path+".fixture",path);
    ' "$target"
  host_docker exec --env DOCKER_HOST=unix:///var/run/docker.sock --env "VERITY_STATE_DIR=$root/host" \
    --env VERITY_API_HOST_PORT=0 --env VERITY_PAIRING_HOST=127.0.0.1 "$fresh" \
    sh -c 'umask 077; exec /opt/verity-install/deploy/bin/verity-install --image "$1" >"$2/test-image-install.log" 2>&1' sh "$target" "$root" || status=$?
  if [[ $status != 0 ]]; then
    inside sh -c 'sed -n "/^verity-install:/p; /^verity-backup-prerequisites:/p; /^docker: Error response from daemon:/p; /^Error: VERITY_SERVER_IMAGE/p" "$1/test-image-install.log"' sh "$root" >&2 || true
    echo "isolated test-image installation failed (exit $status)" >&2
    return "$status"
  fi
}
build_test_image
install_test_image "$enabled_digest"
run_driver verify-enabled-restart
install_test_image "$digest"
run_driver assert-prerequisites

echo '--- recovery: real root helper exposed-generation retirement'
run_driver prepare-exposure-original
run_identity_helper() {
  local status=0
  host_docker exec --env DOCKER_HOST=unix:///var/run/docker.sock --env "VERITY_STATE_DIR=$root/host" \
    --env "VERITY_BACKUP_IDENTITY_DIR=$root/identity-requests" "$fresh" \
    sh -c 'umask 077; exec /opt/verity-install/deploy/host/verity-backup-identity >"$1/exposure.log" 2>&1' sh "$root" || status=$?
  if [[ $status != 0 ]]; then
    # Only fixed helper errors reach CI output; never print ciphertext or process input.
    inside sh -c 'sed -n "/^verity-backup-identity:/p; /^CA backup encryption failed$/p; /^docker: Error response from daemon:/p" "$1/exposure.log"' sh "$root" >&2 || true
    echo "identity helper failed (exit $status)" >&2
    return "$status"
  fi
}
run_identity_helper
run_driver prepare-exposure
run_identity_helper
run_driver assert-exposure

echo '--- recovery: live root identity rotation and old snapshot fencing'
host_docker exec --env DOCKER_HOST=unix:///var/run/docker.sock --env "VERITY_STATE_DIR=$root/host" \
  --env VERITY_PAIRING_HOST=127.0.0.1 --env "VERITY_BACKUP_IDENTITY_DIR=$root/identity-requests" "$fresh" \
  sh -c 'umask 077; exec /opt/verity-install/deploy/bin/verity-install --rotate-identity >"$1/rotation.log" 2>&1' sh "$root" || {
    # Restrict output to fixed installer/helper errors and the public phase name.
    inside sh -c 'sed -n "/^verity-install:/p; /^verity-pairing-material:/p; /^verity-backup-identity:/p; /^CA backup encryption failed$/p; /^docker: Error response from daemon:/p; /^psql:/p; /^ERROR:/p" "$1/rotation.log"; if [ -f "$1/host/identity-rotation/checkpoint" ]; then jq -r "\"rotation phase: \" + .phase" "$1/host/identity-rotation/checkpoint"; fi' sh "$root" >&2 || true
    exit 1
  }
run_driver verify-rotated-api
run_driver retired-identity

echo '--- recovery: interrupted rollback refences resumed managed writers'
new_identity=1
prepare_reviewed
run_driver advance
set +e
run_driver abort rollback-resume >"$work/rollback-interruption.log" 2>&1
rollback_status=$?
set -e
[[ $rollback_status = 137 ]]
run_driver abort
run_driver assert-aborted

echo '--- recovery: new identity retains no old device credentials'
new_identity=1
prepare_reviewed
run_driver advance
run_driver assert-restored
run_driver advance
activate_installer
run_driver verify-api
echo '--- recovery: two independently accepted hosts retain and collect only owned repositories'
run_driver owned-maintenance
host_docker cp "$first_fresh:$root/ownership-result" "$work/first-ownership.json"
host_docker cp "$first_fresh:$root/new-backups/repositories" "$work/peer-repositories"
first_daemon_id=$daemon_id
# Park the first disposable installation while the second runs to bound CI memory use.
mapfile -t parked_containers < <(inner ps -q)
if (( ${#parked_containers[@]} )); then inner stop "${parked_containers[@]}" >/dev/null; fi
fresh=$second
new_identity=0
start_host "$fresh"
[[ $daemon_id != "$first_daemon_id" && $daemon_id != "$original_id" ]]
host_docker cp "$work/copied/." "$fresh:$root"
host_docker cp "$work/peer-repositories" "$fresh:$root/peer-repositories"
run_driver seed-compose
prepare_reviewed
run_driver late-revoke
run_driver advance
run_driver assert-restored
run_driver advance
activate_installer
run_driver verify-api
run_driver verify-restored-schedule
run_driver assert-prerequisites
build_test_image
install_test_image "$enabled_digest"
run_driver verify-enabled-restart
install_test_image "$digest"
run_driver assert-prerequisites
run_driver owned-maintenance
host_docker cp "$second:$root/ownership-result" "$work/second-ownership.json"
node --input-type=module -e 'import assert from "node:assert/strict"; import {readFileSync} from "node:fs"; const [a,b]=process.argv.slice(1).map(p=>JSON.parse(readFileSync(p))); assert.notEqual(a.installationId,b.installationId); assert.notEqual(a.repository,b.repository);' "$work/first-ownership.json" "$work/second-ownership.json"
run_driver verify-owned-unchanged
fresh=$first_fresh
daemon_name=$first_fresh
socket="unix://$work/fresh/docker.sock"
daemon_id=$first_daemon_id
run_driver verify-owned-unchanged
echo 'Separate-host capture, restore, interruption, abort, acceptance and identity checks passed.'
