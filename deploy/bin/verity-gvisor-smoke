#!/usr/bin/env bash
# Exercise the pinned Docker runsc runtime on a real host without secrets or network access.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
deploy_dir="$(cd -- "$script_dir/.." && pwd)"
# shellcheck source=../gvisor/versions.env
source "$deploy_dir/gvisor/versions.env"

for tool in docker jq sha512sum uname; do
  command -v "$tool" >/dev/null || { echo "missing required host tool: $tool" >&2; exit 1; }
done

runtime_path="/opt/verity/runsc/$RUNSC_RELEASE/runsc"
case "$(uname -m)" in
  x86_64) checksum=$RUNSC_SHA512_X86_64 ;;
  aarch64|arm64) checksum=$RUNSC_SHA512_AARCH64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
printf '%s  %s\n' "$checksum" "$runtime_path" | sha512sum --check --status || {
  echo "runsc binary does not match the pinned $RUNSC_RELEASE checksum" >&2
  exit 1
}

registration="$(docker info --format '{{json .Runtimes.runsc}}')"
jq --exit-status \
  --arg path "$runtime_path" \
  '.path == $path and .runtimeArgs == ["--platform=systrap", "--network=none"]' \
  <<<"$registration" >/dev/null || {
    echo 'Docker runsc registration does not match the pinned path and arguments' >&2
    exit 1
  }

# Project Sandboxes (public previews) run under a second registration of the same binary. It needs
# gVisor's netstack for the relay and `--host-uds=create` so the Server can reach the supervisor
# socket the Sandbox binds; `packages/server/src/gvisor-runtime-config.ts` explains both.
project_registration="$(docker info --format '{{json (index .Runtimes "runsc-project")}}')"
jq --exit-status \
  --arg path "$runtime_path" \
  '.path == $path and .runtimeArgs == ["--platform=systrap", "--network=sandbox", "--host-uds=create"]' \
  <<<"$project_registration" >/dev/null || {
    echo 'Docker runsc-project registration does not match the pinned path and arguments; run deploy/gvisor/install-runsc-host.sh' >&2
    exit 1
  }

image="${VERITY_GVISOR_SMOKE_IMAGE:-$RUNSC_SMOKE_IMAGE}"
if [[ ! $image =~ @sha256:[a-f0-9]{64}$ && ! $image =~ ^sha256:[a-f0-9]{64}$ ]]; then
  echo 'VERITY_GVISOR_SMOKE_IMAGE must be pinned by a full sha256 digest or image ID' >&2
  exit 1
fi

container="verity-gvisor-smoke-$$"
container_id=''
cleanup_best_effort() {
  if [[ -n $container_id ]]; then
    docker rm --force "$container_id" >/dev/null 2>&1 || true
  fi
}
trap cleanup_best_effort EXIT INT TERM

if [[ $image == sha256:* ]]; then
  docker image inspect "$image" >/dev/null
else
  docker pull "$image" >/dev/null
fi
container_id="$(docker create \
  --name "$container" \
  --runtime runsc \
  --network none \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16777216 \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --pids-limit 32 \
  --memory 64m \
  --cpus 0.25 \
  --restart no \
  --user 65532:65532 \
  --entrypoint /bin/sh \
  "$image" -c 'printf "%s\n" verity-gvisor-smoke-ok')"
[[ -n $container_id ]] || { echo 'Docker create returned no container ID' >&2; exit 1; }

inspect="$(docker inspect "$container_id")"
jq --exit-status \
  '.[0].HostConfig.Runtime == "runsc" and
   .[0].HostConfig.NetworkMode == "none" and
   .[0].HostConfig.ReadonlyRootfs == true and
   .[0].HostConfig.Privileged == false and
   .[0].HostConfig.CapDrop == ["ALL"] and
   (.[0].HostConfig.CapAdd == null or .[0].HostConfig.CapAdd == []) and
   (.[0].HostConfig.Devices == null or .[0].HostConfig.Devices == []) and
   (.[0].HostConfig.DeviceRequests == null or .[0].HostConfig.DeviceRequests == []) and
   (.[0].HostConfig.DeviceCgroupRules == null or .[0].HostConfig.DeviceCgroupRules == []) and
   (.[0].HostConfig.Binds == null or .[0].HostConfig.Binds == []) and
   (.[0].HostConfig.Mounts == null or .[0].HostConfig.Mounts == []) and
   .[0].HostConfig.SecurityOpt == ["no-new-privileges:true"] and
   .[0].HostConfig.RestartPolicy.Name == "no" and
   .[0].HostConfig.PidsLimit == 32 and
   .[0].HostConfig.Memory == 67108864 and
   .[0].HostConfig.NanoCpus == 250000000 and
   (.[0].HostConfig.Tmpfs | keys) == ["/tmp"] and
   (.[0].HostConfig.Tmpfs["/tmp"] | split(",") | sort) ==
     (["rw", "noexec", "nosuid", "nodev", "size=16777216"] | sort) and
   (.[0].Config.Volumes == null or .[0].Config.Volumes == {}) and
   .[0].Config.User == "65532:65532" and
   .[0].Config.Entrypoint == ["/bin/sh"] and
   .[0].Config.Cmd == ["-c", "printf \"%s\\n\" verity-gvisor-smoke-ok"]' \
  <<<"$inspect" >/dev/null || {
    echo 'created smoke container does not match the required isolation profile' >&2
    exit 1
  }

output="$(docker start --attach "$container_id")"
[[ $output == *verity-gvisor-smoke-ok* ]] || {
  echo 'runsc smoke workload did not return its completion marker' >&2
  exit 1
}

docker rm --force "$container_id" >/dev/null
container_id=''

# The project runtime, exercised the way a project Runner uses it. A registration that exists but
# cannot carry these is the v1.5.0 failure: a running Sandbox whose supervisor socket the Server
# never sees ("the project supervisor socket is missing") and whose relay it cannot reach.
project_suffix="verity-gvisor-project-smoke-$$"
project_ids=()
cleanup_project_best_effort() {
  for id in "${project_ids[@]}"; do docker rm --force "$id" >/dev/null 2>&1 || true; done
  docker volume rm --force "$project_suffix" >/dev/null 2>&1 || true
  docker network rm "$project_suffix" >/dev/null 2>&1 || true
}
trap cleanup_project_best_effort EXIT INT TERM
docker network create --internal "$project_suffix" >/dev/null
docker volume create "$project_suffix" >/dev/null
# The limits leave room for gVisor itself: the sentry's threads and memory are charged to the
# container's cgroup, so a limit sized for a bare `sh` (the Secret-job smoke) starves node.
hardening=(--cap-drop ALL --security-opt no-new-privileges:true --pids-limit 512 --memory 1g
  --user 65532:65532 --restart no --entrypoint node)
project_diagnostics() {
  local id="${project_ids[0]:-}"
  [[ -n $id ]] || return 0
  docker inspect --format \
    'runsc-project sandbox: status={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} error={{.State.Error}}' \
    "$id" >&2 || true
  docker logs --tail 40 "$id" 2>&1 | sed 's/^/runsc-project sandbox log: /' >&2 || true
}
# 1. The Sandbox binds a Unix socket in its volume; a runc peer (the Server's side) must connect.
docker run --rm --user 0:0 --cap-drop ALL --cap-add CHOWN --security-opt no-new-privileges:true \
  --network none --entrypoint /bin/sh -v "$project_suffix:/v" "$image" \
  -c 'chown 65532:65532 /v' >/dev/null
project_ids+=("$(docker run --detach --runtime runsc-project --network "$project_suffix" \
  "${hardening[@]}" -v "$project_suffix:/run/verity-runner" "$image" -e \
  'require("node:net").createServer((s)=>s.end("uds-ok\n")).listen("/run/verity-runner/smoke.sock");
   require("node:net").createServer((s)=>s.end("tcp-ok\n")).listen(8080);
   setTimeout(()=>{},60000)')")
peer_script='const [kind,target]=process.argv.slice(1);const net=require("node:net");
  const deadline=Date.now()+15000;const attempt=()=>{const c=kind==="uds"?net.createConnection(target):net.createConnection(8080,target);
  c.on("data",(d)=>{process.stdout.write(String(d));process.exit(0)});
  c.on("error",(e)=>{if(Date.now()>deadline){console.error(`peer: ${e.code??e.message}`);process.exit(1)}setTimeout(attempt,250)})};attempt()'
uds_output="$(docker run --rm --network none "${hardening[@]}" -v "$project_suffix:/srv" "$image" \
  -e "$peer_script" uds /srv/smoke.sock)" || true
[[ $uds_output == *uds-ok* ]] || {
  project_diagnostics
  echo 'a Unix socket bound inside runsc-project is not reachable from the host side (--host-uds=create)' >&2
  exit 1
}
# 2. A peer on the project network reaches the Sandbox over gVisor's netstack (the relay path).
sandbox_ip="$(docker inspect --format "{{(index .NetworkSettings.Networks \"$project_suffix\").IPAddress}}" "${project_ids[0]}")"
tcp_output="$(docker run --rm --network "$project_suffix" "${hardening[@]}" "$image" \
  -e "$peer_script" tcp "$sandbox_ip")" || true
[[ $tcp_output == *tcp-ok* ]] || {
  project_diagnostics
  echo 'runsc-project has no working network on a project network (--network=sandbox)' >&2
  exit 1
}
cleanup_project_best_effort
project_ids=()
trap - EXIT INT TERM
echo "gVisor smoke passed with $RUNSC_RELEASE: a networkless runsc container and a runsc-project Sandbox with host-visible sockets and a project network"
