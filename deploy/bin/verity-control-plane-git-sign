#!/bin/sh
# The control-plane runner's `gpg.ssh.program`. Generated-in-image twin of the script
# `materializeControlPlaneGitSigner` writes for the in-process control-plane path
# (packages/server/src/embedded.ts): a sealed-runner turn never reaches that code, and the
# script it writes lives on a filesystem this container does not mount.
#
# Without it the failure is a puzzle rather than an answer. The repo's own config asks for
# signed commits, no broker wrapper is reachable, so git falls back to plain `ssh-keygen`
# and reports "No private key found for public key …" — which reads as a lost or
# misconfigured key, and invites exactly the improvisations the project forbids: hunting for
# another key, or committing through the GitHub API.
#
# Only `-Y sign` is intercepted. Every other invocation is handed to the real ssh-keygen, so
# signature VERIFICATION keeps working in a control-plane session — git uses the same program
# for both, and refusing wholesale would break reading history.
if [ "${1:-}" = "-Y" ] && [ "${2:-}" = "sign" ]; then
  echo "verity: the control-plane runner cannot sign commits — it has no signing broker token," >&2
  echo "and a signing capability is bound to a project sandbox generation, which it does not have." >&2
  echo "It also has no GitHub credentials and no gh CLI, so it cannot push or open a pull request." >&2
  echo "Do repo work in a project session for this repository: commit, review and push from there." >&2
  exit 1
fi
exec ssh-keygen "$@"
