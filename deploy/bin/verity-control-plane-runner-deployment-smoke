#!/usr/bin/env bash
# Live image gate for the isolated Claude ACP control-plane runner.
set -euo pipefail

IMAGE="${1:?usage: verity-control-plane-runner-deployment-smoke <server-image>}"
SUFFIX="${VERITY_SMOKE_SUFFIX:-$$}"
CONTAINER="verity-control-runner-smoke-$SUFFIX"
RUNTIME="verity-control-runner-runtime-smoke-$SUFFIX"
IDENTITY="verity-control-runner-identity-smoke-$SUFFIX"
WORK="verity-control-runner-work-smoke-$SUFFIX"
SESSIONS="verity-control-runner-sessions-smoke-$SUFFIX"

cleanup() {
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker volume rm "$RUNTIME" "$IDENTITY" "$WORK" "$SESSIONS" >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup
for volume in "$RUNTIME" "$IDENTITY" "$WORK" "$SESSIONS"; do
  docker volume create "$volume" >/dev/null
done

publish_identity() {
  local generation="$1"
  docker run --rm --user root -v "$IDENTITY:/identity" --env "GENERATION=$generation" \
    --entrypoint /bin/sh "$IMAGE" -c '
    set -eu
    root=/identity/.next
    mkdir -p "$root"
    openssl req -x509 -newkey rsa:2048 -nodes -subj /CN=smoke-ca \
      -keyout /tmp/ca.key -out "$root/ca.crt" -days 1 >/dev/null 2>&1
    openssl req -newkey rsa:2048 -nodes -subj /CN=verity-control \
      -keyout "$root/client.key" -out /tmp/client.csr >/dev/null 2>&1
    openssl x509 -req -in /tmp/client.csr -CA "$root/ca.crt" -CAkey /tmp/ca.key \
      -CAserial /tmp/ca.srl -CAcreateserial -out "$root/client.crt" -days 1 >/dev/null 2>&1
    chown 0:1101 /identity
    chmod 2770 /identity
    for file in ca.crt client.crt client.key; do
      chown 1101:1101 "$root/$file"
      chmod 0640 "$root/$file"
      mv -f "$root/$file" "/identity/$file"
    done
    printf "%s\n" "$GENERATION" > /identity/.generation.next
    chown 1101:1101 /identity/.generation.next
    chmod 0640 /identity/.generation.next
    mv -f /identity/.generation.next /identity/generation
    rmdir "$root"
  '
}

await_generation_ack() {
  for _attempt in $(seq 1 100); do
    if docker exec --user root "$CONTAINER" cmp /run/verity-control-identity/generation \
      /run/verity-runner/claude-egress-generation >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  docker exec --user root "$CONTAINER" cmp /run/verity-control-identity/generation \
    /run/verity-runner/claude-egress-generation
}

connector_pid() {
  docker exec --user root "$CONTAINER" sh -c '
    pid_file="$(find /tmp /run -name egress-connector.pid -type f 2>/dev/null | head -n 1)"
    [ -n "$pid_file" ] || exit 1
    pid="$(awk "{print \$1}" "$pid_file" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || exit 1
    printf "%s\n" "$pid"
  '
}

await_connector_pid_change() {
  local previous="${1:-}"
  local pid=''
  for _attempt in $(seq 1 100); do
    pid="$(connector_pid 2>/dev/null || true)"
    if [ -n "$pid" ] && [ "$pid" != "$previous" ]; then
      printf '%s\n' "$pid"
      return 0
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" != true ]; then
      docker logs "$CONTAINER" >&2
      return 1
    fi
    sleep 0.2
  done
  echo "Claude egress connector did not become ready with a new PID" >&2
  docker logs "$CONTAINER" >&2
  docker exec --user root "$CONTAINER" sh -c \
    'find /tmp /run -name "*connector*" -o -name "*reconcile*" 2>/dev/null | sort' >&2 || true
  return 1
}

publish_identity first
docker run --rm --user root \
  -v "$RUNTIME:/runtime" -v "$WORK:/work" -v "$SESSIONS:/sessions" \
  --entrypoint /bin/sh "$IMAGE" -c '
    set -eu
    chown 1000:1101 /runtime
    chmod 0170 /runtime
    chown 1000:1000 /work /sessions
    # Stands in for a control-plane session worktree. Created here because the
    # Runner itself drops CAP_DAC_OVERRIDE and cannot write this Server-owned mount.
    mkdir -p /sessions/agent-smoke
    chown 1000:1000 /sessions/agent-smoke
  '

docker run -d --name "$CONTAINER" --user root --group-add 1101 \
  --cap-drop ALL --cap-add CHOWN --cap-add SETUID --cap-add SETGID \
  --cap-add KILL --cap-add SETPCAP --security-opt no-new-privileges:true \
  -v "$RUNTIME:/run/verity-runner" -v "$IDENTITY:/run/verity-control-identity:ro" \
  -v "$WORK:/work" -v "$SESSIONS:/srv/verity/sessions" \
  -e VERITY_CLAUDE_EGRESS_URL=https://127.0.0.1:9443 \
  -e VERITY_CLAUDE_EGRESS_AUTHORITY=127.0.0.1:9443 \
  -e VERITY_CLAUDE_EGRESS_SERVERNAME=127.0.0.1 \
  -e VERITY_CLAUDE_CONNECTOR_RECONCILE_SECONDS=1 \
  --entrypoint /usr/bin/tini "$IMAGE" -- /usr/local/bin/verity-control-plane-runner-start \
  >/dev/null

for _attempt in $(seq 1 100); do
  if docker exec --user root "$CONTAINER" test -S /run/verity-runner/supervisor.sock 2>/dev/null; then
    break
  fi
  if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" != true ]; then
    docker logs "$CONTAINER" >&2
    exit 1
  fi
  sleep 0.1
done
docker exec --user root "$CONTAINER" sh -c '
  test -S /run/verity-runner/supervisor.sock
  test "$(stat -c %u:%g /run/verity-runner/supervisor.sock)" = 1101:1101
  test -S /run/verity-runner-broker/agent-spawn-broker.sock
'
# The foreground supervisor can accept connections before the background
# connector reconciler publishes its first generation acknowledgement. Wait for
# that independent readiness condition instead of racing it against the socket.
await_generation_ack

old_pid="$(await_connector_pid_change)"
publish_identity second
new_pid="$(await_connector_pid_change "$old_pid")"
await_generation_ack
docker exec --user root "$CONTAINER" test ! -e \
  /run/verity-runner-broker/connector-reconcile.failed

# A later successful generation must clear a prior unhealthy marker without a
# container restart. The launcher unit tests cover creation on command failure;
# this live gate covers recovery plus the generation acknowledgment.
docker exec --user root "$CONTAINER" touch \
  /run/verity-runner-broker/connector-reconcile.failed
publish_identity recovered
await_connector_pid_change "$new_pid" >/dev/null
await_generation_ack
docker exec --user root "$CONTAINER" test ! -e \
  /run/verity-runner-broker/connector-reconcile.failed

# The cwd guard this Runner lives or dies by. Control-plane session worktrees are
# NOT under this container's /work (the `verity-control` clone) — the Server
# allocates them under `workspacesDir` and leaves that shared namespace
# unrewritten, which is why `/srv/verity/sessions` is mounted beside /work. The
# broker has to accept that second root and no other. Only a live gate can prove
# it: it takes the real launcher's environment, the real broker, and both real
# mounts, and none of those exist below the image level.
#
# In particular the broker's own startup check does NOT stand in for this. It
# asserts that its configured shared root is a directory — nothing more. A
# directory is what an empty, unmounted path looks like too, so that check would
# pass on a Runner whose `verity-data:sessions` mount was dropped. Only a request
# carrying a cwd the Server really allocated distinguishes the two.
#
# The verdict is normalized to one line here rather than matched as raw JSON, so
# an assertion cannot be satisfied by a substring of some unrelated frame.
broker_request() {
  docker exec --user root --env "VERITY_SMOKE_CWD=$1" "$CONTAINER" node -e '
    const { createConnection } = require("node:net");
    const socket = createConnection("/run/verity-runner-broker/agent-spawn-broker.sock");
    let buffered = "";
    socket.on("connect", () =>
      socket.write(
        JSON.stringify({
          protocolVersion: 1,
          kind: "spawn-agent",
          command: "claude-agent-acp",
          args: ["--version"],
          cwd: process.env.VERITY_SMOKE_CWD,
        }) + "\n",
      ),
    );
    socket.on("data", (chunk) => {
      buffered += chunk;
      const newline = buffered.indexOf("\n");
      if (newline < 0) return;
      const line = buffered.slice(0, newline);
      socket.destroy();
      let frame;
      try {
        frame = JSON.parse(line);
      } catch {
        process.stderr.write("unparseable broker frame: " + line + "\n");
        process.exit(1);
      }
      process.stdout.write(
        (frame.ok === true
          ? "accepted " + String(frame.kind)
          : "refused " + String(frame.error)) + "\n",
      );
    });
    socket.on("error", (error) => {
      process.stderr.write(String(error) + "\n");
      process.exit(1);
    });
  '
}

# The POSITIVE outcome, not the absence of one error string. A request the broker
# rejected for any other pre-spawn reason — a malformed frame, a failed executable
# check, a child that never started — is not evidence that the shared root was
# accepted, and a gate that goes green on those is worse than no gate because it
# will be trusted. `spawned` is the one frame the broker emits only after the
# guard passed AND the child actually started.
#
# It does not require the agent to be usable: `spawned` fires when setpriv execs,
# well before the adapter decides whether it can run. The socket is closed
# immediately after, which is the broker's cue to SIGKILL the process group.
#
# The command is the ACP adapter because that is the only Claude command the
# broker maps now (ADR 0012) — the native `claude` it replaced is refused as an
# unknown command, which would fail this gate for a reason that has nothing to do
# with the shared worktree root it exists to prove.
accepted="$(broker_request /srv/verity/sessions/agent-smoke)"
if [ "$accepted" != 'accepted spawned' ]; then
  echo "the control-plane session worktree was not spawned by the broker: $accepted" >&2
  exit 1
fi
# And nothing wider: a directory that exists in the container but belongs to
# neither mounted tree must still be refused, by the guard and not by accident.
refused="$(broker_request /run)"
if [ "$refused" != 'refused agent cwd escaped the worktree root' ]; then
  echo "a cwd outside every mounted worktree root was not refused: $refused" >&2
  exit 1
fi

echo 'Control-plane Runner deployment smoke passed'
