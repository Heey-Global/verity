#!/usr/bin/env bash
set -euo pipefail

image="${1:?usage: verity-secret-job-worker-smoke IMAGE}"

node - "$image" <<'NODE'
const { execFileSync } = require('node:child_process');
const image = process.argv[2];
const inspected = JSON.parse(execFileSync('docker', ['image', 'inspect', image], { encoding: 'utf8' }))[0];
const config = inspected.Config;
if (config.User !== '65532:65532') throw new Error(`unexpected image user: ${config.User}`);
if (JSON.stringify(config.Entrypoint) !== JSON.stringify(['/usr/local/bin/verity-secret-job-worker'])) {
  throw new Error(`unexpected entrypoint: ${JSON.stringify(config.Entrypoint)}`);
}
if ((config.Cmd ?? []).length !== 0) throw new Error('worker image must not define mutable argv');
if ((config.Env ?? []).some((entry) => /^VERITY_|SECRET|TOKEN|KEY/i.test(entry))) {
  throw new Error('worker image config carries secret-adjacent environment');
}
NODE

set +e
diagnostic="$(docker run --rm --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges "$image" </dev/null 2>&1)"
status=$?
set -e
if [[ "$status" -ne 1 || "$diagnostic" != 'verity secret-job worker failed closed' ]]; then
  echo "worker did not fail closed on empty stdin (status=$status)" >&2
  exit 1
fi

set +e
docker run --rm --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges \
  --env API_TOKEN=pilot-absence-probe \
  --entrypoint /usr/local/bin/verity-secret-job-pilot "$image" >/dev/null 2>&1
pilot_status=$?
set -e
if [[ "$pilot_status" -eq 0 ]]; then
  echo 'release worker image unexpectedly contains a runnable pilot' >&2
  exit 1
fi
