# Installed by deploy/bin/verity-install. Answers one pending request from the managed Updater:
# verify the named release image's signature, and install the devcontainer builder it ships
# when that differs from the installed one.
[Unit]
Description=Reconcile Verity's devcontainer builder
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/verity/verity-host-builder apply-request
# Pulling BuildKit and the CNI plugins, plus the builder's own start.
TimeoutStartSec=20min
# No ProtectSystem: the builder's installer is the same root installer verity-install runs,
# and writes /etc/verity-buildkit, its systemd unit, /usr/local/libexec/verity-buildkit, the
# pinned runsc under /opt/verity and the runtime entries in /etc/docker/daemon.json.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
