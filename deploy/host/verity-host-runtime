#!/usr/bin/env bash
# Reconcile the Docker runtime registrations a Verity release needs on this host.
#
# The one host component Verity installs (ADR 0008 Amendment 2). The managed Updater is a
# container with the Docker socket and nothing else: it cannot write /etc/docker or reload
# dockerd, and a release that needs a new runtime registration (runsc-project, a gVisor bump)
# must not reach a host that lacks it. So the Updater asks, through a request file in a
# root-owned host directory, and this script answers: install the pinned, checksum-verified
# runsc, merge exactly the two runtime entries into daemon.json, reload Docker, and report.
# Nothing else.
#
# gVisor publishes runsc in one of two ways, and a pin names which. Older releases ship a
# single `runsc` binary. Newer ones ship `gvisor.tar.bz2`, whose runsc refuses to start a
# sandbox without the sidecar binaries in `gvisor-bin/` next to it. For those, both the
# archive and the runsc inside it are pinned. The archive is verified before a single member
# is unpacked, the whole tree is assembled in a staging directory, and the release directory
# appears by rename once complete. Every other release directory stays as it is, because
# running containers and a rollback still use them.
#
#   verity-host-runtime apply-pins <versions.env>   reconcile from a pin file (verity-install)
#   verity-host-runtime apply-request               answer the pending request (systemd path unit)
#   verity-host-runtime install-self                replace the installed copy with this one
#
# Every step is idempotent and each state it can be interrupted in is one the next run
# finishes from: a binary is only ever renamed into place once verified, daemon.json only once
# `dockerd --validate` accepted it, and a live registration that disagrees with the file is
# settled by a reload. Running containers are not restarted: a reload re-reads `runtimes`
# without touching them. A reload that does not converge restores the previous daemon.json.
set -euo pipefail
umask 0022

DAEMON_JSON="${VERITY_DOCKER_DAEMON_JSON:-/etc/docker/daemon.json}"
RUNSC_ROOT="${VERITY_RUNSC_ROOT:-/opt/verity/runsc}"
STATE_DIR="${VERITY_HOST_RUNTIME_DIR:-/var/lib/verity/host-runtime}"
# Root-only and never mounted into a container, unlike STATE_DIR, which the Updater writes
# requests into: the lock and the daemon.json backup must not be something a requester can
# replace with a symbolic link or rewrite before a restore.
PRIVATE_DIR="${VERITY_HOST_RUNTIME_PRIVATE_DIR:-/var/lib/verity/host-runtime-private}"
DOCKER_PID_FILE="${VERITY_DOCKER_PID_FILE:-/var/run/docker.pid}"
SYSTEMD_RUN_DIR="${VERITY_SYSTEMD_RUN_DIR:-/run/systemd/system}"
RELOAD_TIMEOUT_SECONDS="${VERITY_HOST_RUNTIME_RELOAD_TIMEOUT:-30}"
DOWNLOAD_BASE='https://storage.googleapis.com/gvisor/releases/release'
# Where verity-install puts this script. `install-self` replaces that copy only.
LIBEXEC_DIR="${VERITY_HOST_RUNTIME_LIBEXEC:-/usr/local/libexec/verity}"
# Which pin shapes this copy installs, as advertised in agent.json. The Updater sends an
# archive pin only to a host whose installed copy lists `archive` here.
RUNTIME_ARTIFACTS='["binary","archive"]'
# The only paths a pinned archive may contain. The archive is checksum-pinned already; this
# keeps an unexpected layout from being unpacked at all.
ARCHIVE_MEMBER='^(runsc|containerd-shim-runsc-v1|gvisor-bin/|gvisor-bin/[A-Za-z0-9_][A-Za-z0-9_.-]*)$'
# The sidecar runsc cannot start a sandbox without; its absence means the archive is not one
# this script understands.
REQUIRED_SIDECAR='gvisor-bin/gvisor_sentry'
# The only runtime names and arguments a request may carry. A release that needs another flag
# ships a new copy of this script, which the Verity installer puts in place; the Updater cannot
# widen what this root process will write into daemon.json.
RUNTIME_NAMES='["runsc","runsc-project"]'
ALLOWED_ARGS='["--platform=systrap","--network=none","--network=sandbox","--host-uds=create"]'

log() { printf 'verity-host-runtime: %s\n' "$*" >&2; }
die() {
  log "$*"
  exit 1
}

need_tools() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null || die "missing required host tool: $tool"
  done
}

host_arch() {
  case "${VERITY_HOST_ARCH:-$(uname -m)}" in
    x86_64 | amd64) echo x86_64 ;;
    aarch64 | arm64) echo aarch64 ;;
    *) die "unsupported architecture: ${VERITY_HOST_ARCH:-$(uname -m)}" ;;
  esac
}

# One pin out of versions.env, read as data. The file is never sourced: it travels inside
# release artifacts, and executing it as root would turn a pin file into a root script.
pin() {
  local value
  value="$(sed -n "s/^$1=//p" "$2" | head -n 1)"
  value="${value#\'}"
  printf '%s' "${value%\'}"
}

# RUNSC_SHA512_* always pin the runsc binary. RUNSC_ARCHIVE_SHA512_* are present only for a
# release that ships as an archive, and pin the archive itself.
requirements_from_pins() {
  local file=$1 archive_x86_64 archive_aarch64
  [[ -f $file ]] || die "pin file not found: $file"
  archive_x86_64="$(pin RUNSC_ARCHIVE_SHA512_X86_64 "$file")"
  archive_aarch64="$(pin RUNSC_ARCHIVE_SHA512_AARCH64 "$file")"
  jq -cn \
    --arg release "$(pin RUNSC_RELEASE "$file")" \
    --arg x86_64 "$(pin RUNSC_SHA512_X86_64 "$file")" \
    --arg aarch64 "$(pin RUNSC_SHA512_AARCH64 "$file")" \
    --arg archive_x86_64 "$archive_x86_64" \
    --arg archive_aarch64 "$archive_aarch64" \
    --argjson runsc "$(pin RUNSC_ARGS "$file")" \
    --argjson project "$(pin RUNSC_PROJECT_ARGS "$file")" \
    '{release: $release, sha512: {x86_64: $x86_64, aarch64: $aarch64},
      runtimes: {runsc: $runsc, "runsc-project": $project}}
     + (if $archive_x86_64 == "" and $archive_aarch64 == "" then {}
        else {archiveSha512: {x86_64: $archive_x86_64, aarch64: $archive_aarch64}} end)'
}

# Reject anything outside the fixed shape before a single byte is downloaded or written.
validate_requirements() {
  jq -e \
    --argjson names "$RUNTIME_NAMES" --argjson allowed "$ALLOWED_ARGS" '
      def sums: type == "object" and keys == ["aarch64", "x86_64"]
        and all(.[]; type == "string" and test("^[a-f0-9]{128}$"));
      type == "object"
      and (keys == ["release", "runtimes", "sha512"]
           or (keys == ["archiveSha512", "release", "runtimes", "sha512"] and (.archiveSha512 | sums)))
      and (.release | type == "string" and test("^release-[0-9]{8}\\.[0-9]+$"))
      and (.sha512 | sums)
      and (.runtimes | type == "object" and (keys | sort) == ($names | sort)
           and all(.[]; type == "array" and length > 0 and length <= 8
                   and all(.[]; type == "string" and (. as $arg | $allowed | index($arg) != null))))
    ' <<<"$1" >/dev/null || die 'runtime requirements are malformed or outside the allowed set'
}

runsc_path() { printf '%s/%s/runsc' "$RUNSC_ROOT" "$1"; }

binary_matches() {
  local path=$1 sha=$2 release=$3
  [[ -f $path && ! -L $path ]] || return 1
  printf '%s  %s\n' "$sha" "$path" | sha512sum --check --status || return 1
  [[ $("$path" --version 2>/dev/null | head -n 1) == "runsc version $release" ]]
}

ensure_binary() {
  local release=$1 sha=$2 arch=$3 path dir tmp
  path="$(runsc_path "$release")"
  if binary_matches "$path" "$sha" "$release"; then return 0; fi
  dir="$(dirname "$path")"
  install -d -m 0755 "$dir"
  tmp="$(mktemp "$dir/.runsc.XXXXXX")"
  # shellcheck disable=SC2064 # expand now: the trap must name these paths.
  trap "rm -f '$tmp'; rmdir --ignore-fail-on-non-empty '$dir' 2>/dev/null || true" RETURN EXIT
  log "downloading runsc $release ($arch)"
  curl --fail --silent --show-error --location --proto '=https' \
    "$DOWNLOAD_BASE/${release#release-}/$arch/runsc" --output "$tmp" ||
    die "runsc $release could not be downloaded; check this host's HTTPS egress to storage.googleapis.com"
  printf '%s  %s\n' "$sha" "$tmp" | sha512sum --check --status ||
    die "downloaded runsc does not match the pinned $release checksum; nothing was changed"
  chmod 0755 "$tmp"
  [[ $("$tmp" --version 2>/dev/null | head -n 1) == "runsc version $release" ]] ||
    die "downloaded runsc does not report $release; nothing was changed"
  mv -f "$tmp" "$path"
}

# The release directory of an archive install: runsc as pinned, and every file the archive put
# there unchanged since it was verified.
archive_matches() {
  local dir=$1 sha=$2 archive_sha=$3 release=$4
  [[ -d $dir && ! -L $dir && ! -L $dir/gvisor-bin ]] || return 1
  binary_matches "$dir/runsc" "$sha" "$release" || return 1
  [[ -f $dir/.verity-archive-sha512 && -f $dir/.verity-files.sha512 && -f $dir/$REQUIRED_SIDECAR ]] || return 1
  [[ $(cat "$dir/.verity-archive-sha512") == "$archive_sha" ]] || return 1
  (cd "$dir" && sha512sum --check --status --strict .verity-files.sha512)
}

# Refuse an archive whose listing holds anything but plain files and directories at the
# expected paths, before it is unpacked.
check_archive_listing() {
  local archive=$1 names types name
  names="$(tar -tjf "$archive")" || return 1
  types="$(tar -tvjf "$archive" | cut -c1)" || return 1
  [[ -n $names ]] || return 1
  while IFS= read -r name; do
    [[ $name =~ $ARCHIVE_MEMBER && $name != *..* ]] || {
      log "unexpected archive member: ${name:0:120}"
      return 1
    }
  done <<<"$names"
  [[ -z $(tr -d -- '-d\n' <<<"$types") ]] || {
    log 'the archive contains something other than regular files and directories'
    return 1
  }
}

ensure_archive() {
  local release=$1 sha=$2 archive_sha=$3 arch=$4 dir stage tree
  dir="$RUNSC_ROOT/$release"
  if archive_matches "$dir" "$sha" "$archive_sha" "$release"; then return 0; fi
  install -d -m 0755 "$RUNSC_ROOT"
  # Left behind by a run that was killed; the reconciliation lock is held, so none is in use.
  rm -rf -- "$RUNSC_ROOT"/.stage.*
  # On the same filesystem as the release directory, so the tree lands there by rename.
  stage="$(mktemp -d "$RUNSC_ROOT/.stage.XXXXXX")"
  chmod 0700 "$stage"
  # shellcheck disable=SC2064 # expand now: the trap must name this path.
  trap "rm -rf '$stage'" RETURN EXIT
  log "downloading gVisor $release ($arch)"
  curl --fail --silent --show-error --location --proto '=https' \
    "$DOWNLOAD_BASE/${release#release-}/$arch/gvisor.tar.bz2" --output "$stage/gvisor.tar.bz2" ||
    die "gVisor $release could not be downloaded; check this host's HTTPS egress to storage.googleapis.com"
  printf '%s  %s\n' "$archive_sha" "$stage/gvisor.tar.bz2" | sha512sum --check --status ||
    die "downloaded gVisor archive does not match the pinned $release checksum; nothing was changed"
  check_archive_listing "$stage/gvisor.tar.bz2" ||
    die "the gVisor $release archive has an unexpected layout; nothing was changed"
  tree="$stage/tree"
  install -d -m 0755 "$tree"
  tar -xjf "$stage/gvisor.tar.bz2" -C "$tree" --no-same-owner --no-same-permissions runsc gvisor-bin ||
    die "the gVisor $release archive could not be unpacked; nothing was changed"
  [[ -z $(find "$tree" ! -type f ! -type d -print -quit) ]] ||
    die "the gVisor $release archive unpacked to something other than files; nothing was changed"
  find "$tree" -type d -exec chmod 0755 {} +
  find "$tree" -type f -exec chmod 0755 {} +
  [[ -f $tree/$REQUIRED_SIDECAR ]] ||
    die "the gVisor $release archive lacks $REQUIRED_SIDECAR; nothing was changed"
  printf '%s  %s\n' "$sha" "$tree/runsc" | sha512sum --check --status ||
    die "the runsc in the gVisor $release archive does not match its pinned checksum; nothing was changed"
  [[ $("$tree/runsc" --version 2>/dev/null | head -n 1) == "runsc version $release" ]] ||
    die "the runsc in the gVisor archive does not report $release; nothing was changed"
  (cd "$tree" && find runsc gvisor-bin -type f | LC_ALL=C sort | while IFS= read -r file; do
    sha512sum -- "$file"
  done) >"$tree/.verity-files.sha512" || die 'could not record the unpacked gVisor files; nothing was changed'
  printf '%s\n' "$archive_sha" >"$tree/.verity-archive-sha512"
  chmod 0644 "$tree/.verity-files.sha512" "$tree/.verity-archive-sha512"
  # A directory left by an interrupted or tampered install is set aside, not merged into.
  if [[ -e $dir || -L $dir ]]; then mv -f -- "$dir" "$stage/previous"; fi
  if ! mv -- "$tree" "$dir"; then
    [[ -e $stage/previous ]] && mv -- "$stage/previous" "$dir"
    die "could not install gVisor $release; nothing was changed"
  fi
}

desired_runtimes() {
  jq -cS --arg path "$2" '.runtimes | with_entries(.value = {path: $path, runtimeArgs: .value})' <<<"$1"
}

live_runtimes() {
  docker info --format '{{json .Runtimes}}' 2>/dev/null |
    jq -cS --argjson want "$1" 'with_entries(select(.key as $k | $want | has($k)))
      | with_entries(.value = {path: .value.path, runtimeArgs: (.value.runtimeArgs // [])})'
}

reload_docker() {
  if [[ -d $SYSTEMD_RUN_DIR ]] && command -v systemctl >/dev/null &&
    systemctl is-active --quiet docker 2>/dev/null; then
    systemctl reload docker
  else
    # Docker without systemd (e.g. a Docker-in-Docker host): SIGHUP is what `systemctl reload
    # docker` sends. It re-reads the runtime registrations and restarts no container.
    local pid=''
    [[ -f $DOCKER_PID_FILE ]] && pid="$(cat "$DOCKER_PID_FILE")"
    [[ $pid =~ ^[0-9]+$ ]] || pid="$(pgrep -xo dockerd || true)"
    if [[ ! $pid =~ ^[0-9]+$ ]]; then
      log 'cannot reload Docker: no running docker.service and no dockerd process'
      return 1
    fi
    kill -HUP "$pid"
  fi
}

await_live() {
  local want=$1 deadline=$((SECONDS + RELOAD_TIMEOUT_SECONDS))
  while ((SECONDS < deadline)); do
    [[ $(live_runtimes "$want") == "$want" ]] && return 0
    sleep 1
  done
  return 1
}

apply_requirements() {
  local requirements=$1 arch release sha archive_sha path want current merged backup='' changed=0
  need_tools curl docker dockerd jq sha512sum flock
  validate_requirements "$requirements"
  arch="$(host_arch)"
  release="$(jq -r .release <<<"$requirements")"
  sha="$(jq -r --arg a "$arch" '.sha512[$a]' <<<"$requirements")"
  archive_sha="$(jq -r --arg a "$arch" '.archiveSha512[$a] // empty' <<<"$requirements")"
  [[ -z $archive_sha ]] || need_tools tar bzip2
  path="$(runsc_path "$release")"
  want="$(desired_runtimes "$requirements" "$path")"

  [[ ! -L $PRIVATE_DIR ]] || die "$PRIVATE_DIR must not be a symbolic link"
  install -d -m 0700 "$PRIVATE_DIR"
  exec 9>"$PRIVATE_DIR/lock"
  flock -w 900 9 || die 'another host runtime reconciliation is still running'

  if [[ -n $archive_sha ]]; then
    ensure_archive "$release" "$sha" "$archive_sha" "$arch"
  else
    ensure_binary "$release" "$sha" "$arch"
  fi

  install -d -m 0755 "$(dirname "$DAEMON_JSON")"
  current='{}'
  if [[ -e $DAEMON_JSON ]]; then
    current="$(jq -c . "$DAEMON_JSON")" || die "$DAEMON_JSON is not valid JSON; fix it before retrying"
  fi
  # Only these two entries change. Every other key, and every other runtime, stays as it is.
  merged="$(jq -cS --argjson want "$want" '.runtimes = ((.runtimes // {}) + $want)' <<<"$current")"
  if [[ $(jq -cS . <<<"$current") != "$merged" ]]; then
    local tmp
    tmp="$(mktemp "$(dirname "$DAEMON_JSON")/.daemon.json.verity.XXXXXX")"
    jq . <<<"$merged" >"$tmp"
    chmod 0644 "$tmp"
    if ! dockerd --validate --config-file "$tmp" >/dev/null 2>&1; then
      rm -f "$tmp"
      die "Docker rejects the merged $DAEMON_JSON (dockerd --validate); nothing was changed"
    fi
    if [[ -e $DAEMON_JSON ]]; then
      backup="$PRIVATE_DIR/daemon.json.previous"
      cp -p "$DAEMON_JSON" "$backup"
    fi
    mv -f "$tmp" "$DAEMON_JSON"
    changed=1
  fi

  # Also after an interruption between the write and the reload: the file already says what
  # it should, but dockerd has not read it yet.
  if [[ $(live_runtimes "$want") != "$want" ]]; then
    log 'reloading Docker to register the runtimes (running containers are not restarted)'
    if ! { reload_docker && await_live "$want"; }; then
      if ((changed)); then
        if [[ -n $backup ]]; then cp -p "$backup" "$DAEMON_JSON"; else rm -f "$DAEMON_JSON"; fi
        reload_docker || true
        die "Docker did not register the runtimes after a reload; the previous $DAEMON_JSON was restored"
      fi
      die "Docker does not report the runtimes $DAEMON_JSON declares, even after a reload; check dockerd's log (other daemon flags may override runtimes)"
    fi
  fi
  log "runtimes runsc and runsc-project are registered for $release"
}

write_json_atomically() {
  local target=$1 body=$2 tmp
  tmp="$(mktemp "$(dirname "$target")/.$(basename "$target").XXXXXX")"
  printf '%s\n' "$body" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$target"
}

apply_request() {
  local request="$STATE_DIR/request.json" result="$STATE_DIR/result.json" id requirements output status
  need_tools jq
  [[ -f $request ]] || return 0
  id="$(jq -er 'select(.version == 1) | .id | select(type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"))' "$request")" ||
    die 'request.json is not a version-1 request'
  # Already answered: a path unit fires again on every rewrite of the same request, and the
  # Updater rewrites it whenever it resumes an operation.
  if [[ -f $result ]] && [[ $(jq -r '.id // empty' "$result") == "$id" ]] &&
    [[ $(jq -r '.ok' "$result") == true ]]; then
    return 0
  fi
  requirements="$(jq -c '.requirements' "$request")"
  status=0
  output="$( (apply_requirements "$requirements") 2>&1)" || status=$?
  printf '%s\n' "$output" >&2
  write_json_atomically "$result" "$(jq -cn --arg id "$id" --argjson ok "$([[ $status -eq 0 ]] && echo true || echo false)" \
    --arg message "$(printf '%s' "$output" | tail -n 1 | sed 's/^verity-host-runtime: //')" \
    --arg finishedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{version: 1, id: $id, ok: $ok, message: $message, finishedAt: $finishedAt}')"
  return "$status"
}

# Replace the copy verity-install put in place with this one, and advertise what it installs.
# Run from a verified release bundle (deploy/buildkit/install.sh, which the host builder runs
# out of a signature-checked Server image), so a host learns new pin shapes through a regular
# update instead of a manual installer run. A host this installer never set up is left alone.
install_self() {
  local target="$LIBEXEC_DIR/verity-host-runtime" agent="$STATE_DIR/agent.json" tmp
  if [[ ! -f $target || -L $target ]]; then
    log "no installed host runtime service at $target; nothing to replace"
    return 0
  fi
  need_tools jq sha512sum
  # sha512sum rather than cmp: every host already has it, and a missing tool here would fail
  # the builder install that runs this.
  if [[ $(sha512sum <"${BASH_SOURCE[0]}") != $(sha512sum <"$target") ]]; then
    tmp="$(mktemp "$LIBEXEC_DIR/.verity-host-runtime.XXXXXX")"
    cp -- "${BASH_SOURCE[0]}" "$tmp"
    chmod 0755 "$tmp"
    bash -n "$tmp" || {
      rm -f -- "$tmp"
      die 'the bundled host runtime service does not parse; the installed one was kept'
    }
    mv -f -- "$tmp" "$target"
    log "installed the host runtime service from this release"
  fi
  # Only after the copy above: the Updater must never be told about a shape the installed
  # copy cannot take yet.
  [[ -f $agent && ! -L $agent ]] || return 0
  write_json_atomically "$agent" "$(jq -c --argjson artifacts "$RUNTIME_ARTIFACTS" \
    '. + {runtimeArtifacts: $artifacts}' "$agent")" || die "could not update $agent"
}

[[ $(id -u) -eq 0 || ${VERITY_HOST_RUNTIME_TEST:-} == 1 ]] || die 'must run as root'
case "${1:-}" in
  apply-pins)
    [[ $# -eq 2 ]] || die 'usage: verity-host-runtime apply-pins <versions.env>'
    need_tools jq
    apply_requirements "$(requirements_from_pins "$2")"
    ;;
  apply-request) apply_request ;;
  install-self) install_self ;;
  *) die 'usage: verity-host-runtime apply-pins <versions.env> | apply-request | install-self' ;;
esac
