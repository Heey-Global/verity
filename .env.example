# Copy to .env for local development and fill in real values.
# .env is gitignored; never commit real secrets.

# --- Local dev Postgres (docker-compose.yml) ---
POSTGRES_USER=verity
# Required: choose any value for your dev box. Left empty on purpose so an
# un-edited copy trips the `${POSTGRES_PASSWORD:?...}` guard in docker-compose.yml
# instead of silently starting Postgres with a source-controlled password.
POSTGRES_PASSWORD=
POSTGRES_DB=verity
POSTGRES_PORT=5432

# Connection string the control-plane uses. Substitute the same password you
# set above (and host/port if you changed them).
DATABASE_URL=postgres://verity:CHANGE_ME@localhost:5432/verity

# --- Meeting transcription ---
# Uploaded meeting audio is transcribed and written to docs/meetings/*.md. Verity
# bundles no speech-to-text service: point VERITY_PARAKEET_BASE_URL at any
# OpenAI-compatible transcription API (`/audio/transcriptions`) and set the model
# it expects. Left empty, meeting transcription reports itself as not configured.
# In a deploy/docker-compose.yml install these are named VERITY_TRANSCRIBE_* and
# are passed through to the variables below.
VERITY_MEETING_TRANSCRIBE_COMMAND=
VERITY_PARAKEET_BASE_URL=
VERITY_PARAKEET_API_KEY=
VERITY_PARAKEET_MODEL=parakeet-tdt-0.6b
VERITY_PARAKEET_RESPONSE_FORMAT=verbose_json
VERITY_PARAKEET_LANGUAGE=
VERITY_PARAKEET_TIMEOUT_MS=180000
VERITY_PARAKEET_RETRIES=0
VERITY_PARAKEET_RETRY_DELAY_MS=2000
VERITY_PARAKEET_MAX_UPLOAD_BYTES=25000000
VERITY_MEETING_FFMPEG_COMMAND=ffmpeg
VERITY_MEETING_FFMPEG_TIMEOUT_MS=90000
