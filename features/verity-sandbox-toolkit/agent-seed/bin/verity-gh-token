#!/usr/bin/env bash
# Return only a broker capability placeholder; never redeem a GitHub token.
set -euo pipefail
[ "${VERITY_FORGE_MODE:-}" = "proxy-test" ] || exit 1

[ -n "${VERITY_FORGE_PROXY_URL:-}" ] && [ -r "${VERITY_FORGE_PROXY_CA_FILE:-}" ] || exit 1
# The turn's own badge names the turn and its person; the container file names
# only the project. Prefer a well-formed badge, otherwise use the file.
turn_capability="${VERITY_TURN_CAPABILITY:-}"
if [[ "$turn_capability" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
  printf 'verity-broker-%s' "$turn_capability"
  exit 0
fi
cap_file="${VERITY_GH_BROKER_CAPABILITY_FILE:-/run/verity/gh-token-capability}"
[ -r "$cap_file" ] || exit 1
cap="$(tr -d '[:space:]' <"$cap_file")"
[[ "$cap" =~ ^[A-Za-z0-9_-]{43}$ ]] || exit 1
printf 'verity-broker-%s' "$cap"
exit 0
