#!/usr/bin/env bash
# GitHub CLI wrapper: credentials remain in the server-side forge broker.

set -euo pipefail

unset GH_TOKEN GITHUB_TOKEN

candidates=()
if [ -n "${VERITY_GH_REAL:-}" ]; then
candidates+=("$VERITY_GH_REAL")
fi
candidates+=(/usr/local/lib/verity/gh-real /usr/bin/gh /usr/local/bin/gh)

for candidate in "${candidates[@]}"; do
if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
  REAL_GH="$candidate"
  break
fi
done

if [ -z "${REAL_GH:-}" ]; then
echo "gh wrapper: real gh binary not found" >&2
exit 127
fi

[ "${VERITY_FORGE_MODE:-}" = "proxy-test" ] || { echo "gh wrapper: forge proxy required" >&2; exit 1; }
unset GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
TOKEN="$(verity-gh-token)" || { echo "gh wrapper: forge broker test mode unavailable" >&2; exit 1; }
export GH_TOKEN="$TOKEN"
export HTTPS_PROXY="${VERITY_FORGE_PROXY_URL:?}"
export https_proxy="$HTTPS_PROXY"
export SSL_CERT_FILE="${VERITY_FORGE_PROXY_CA_FILE:?}"
export NO_PROXY= no_proxy=
exec "$REAL_GH" "$@"
