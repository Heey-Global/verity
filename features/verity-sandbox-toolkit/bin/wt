#!/usr/bin/env bash
# wt - Worktree manager for parallel dev worktrees.
#
# Usage:
#   wt <branch> [base]   Create a new worktree + a tmux window (login shell) for it
#   wt list              Show active worktrees + their tmux windows
#   wt status            git status per worktree (short form)
#   wt close [--force] <branch>  Remove a clean worktree; --force discards changes
#
# From the host:   docker exec -it <container> wt ...
#
# The tmux window is a plain login shell in the worktree dir — agent-neutral.
# Verity runs agent sessions via the server (`docker exec … <agent>`), so `wt`
# does not launch an agent itself; attach to the window and run whatever you
# need. Shares the entrypoint's session (TMUX_SESSION, default `verity`).
#
# Home-agnostic: all paths derive from $WORKSPACE / env, never a baked home.
set -euo pipefail

SESSION="${TMUX_SESSION:-verity}"
ROOT="${WORKSPACE:-/work}"

sanitize() {
  # feature/rate-limit -> feature-rate-limit (tmux-/path-safe)
  echo "${1//\//-}"
}

cmd_new() {
  local BRANCH="${1:?Usage: wt <branch> [base-branch]}"
  local BASE="${2:-HEAD}"
  local SAFE_BRANCH WT_DIR
  SAFE_BRANCH="$(sanitize "$BRANCH")"
  WT_DIR="$ROOT/.worktrees/$SAFE_BRANCH"

  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$ROOT" worktree add "$WT_DIR" "$BRANCH"
  else
    git -C "$ROOT" worktree add -b "$BRANCH" "$WT_DIR" "$BASE"
  fi

  tmux new-window -t "$SESSION" -n "$SAFE_BRANCH" -c "$WT_DIR" "exec bash -l"

  cat <<EOF
Worktree '$BRANCH' created: $WT_DIR
tmux window:           $SAFE_BRANCH  (in session '$SESSION')
EOF
}

cmd_list() {
  echo "=== Worktrees ==="
  git -C "$ROOT" worktree list
  echo
  echo "=== tmux windows in session '$SESSION' ==="
  tmux list-windows -t "$SESSION" -F '#I  #W  (#{pane_current_path})' 2>/dev/null \
    || echo "(no tmux session active)"
}

cmd_status() {
  local field path
  while IFS= read -r -d '' field; do
    case "$field" in
      'worktree '*)
        path="${field#worktree }"
        [ -d "$path" ] || continue
        echo "=== $path ==="
        git -C "$path" status --short --branch || true
        echo
        ;;
    esac
  done < <(git -C "$ROOT" worktree list --porcelain -z)
}

cmd_close() {
  local FORCE=false
  if [ "${1:-}" = '--force' ]; then FORCE=true; shift; fi
  local BRANCH="${1:?Usage: wt close [--force] <branch>}"
  local SAFE_BRANCH WT_DIR='' FIELD CURRENT_PATH='' CURRENT_BRANCH=''
  SAFE_BRANCH="$(sanitize "$BRANCH")"

  # The display/path slug is not injective (`feature/a-b` and `feature-a/b`
  # collide). Resolve the exact branch through Git's own worktree metadata,
  # then verify the resulting path is inside the managed worktree directory.
  while IFS= read -r -d '' FIELD; do
    case "$FIELD" in
      worktree\ *) CURRENT_PATH="${FIELD#worktree }" ;;
      branch\ *) CURRENT_BRANCH="${FIELD#branch }" ;;
      '')
        if [ "$CURRENT_BRANCH" = "refs/heads/$BRANCH" ]; then
          [ -z "$WT_DIR" ] || { echo "More than one worktree is registered for '$BRANCH'." >&2; return 1; }
          WT_DIR="$CURRENT_PATH"
        fi
        CURRENT_PATH=''
        CURRENT_BRANCH=''
        ;;
    esac
  done < <(git -C "$ROOT" worktree list --porcelain -z)

  if [ -z "$WT_DIR" ]; then
    echo "No worktree registered for branch '$BRANCH'."
    return 0
  fi
  local MANAGED_ROOT RESOLVED_WT
  MANAGED_ROOT="$(realpath -m -- "$ROOT/.worktrees")"
  RESOLVED_WT="$(realpath -m -- "$WT_DIR")"
  case "$RESOLVED_WT" in
    "$MANAGED_ROOT/"*) WT_DIR="$RESOLVED_WT" ;;
    *) echo "Refusing to remove worktree outside $MANAGED_ROOT: $RESOLVED_WT" >&2; return 1 ;;
  esac

  if [ "$FORCE" != true ] && [ -n "$(git -C "$WT_DIR" status --porcelain --untracked-files=all)" ]; then
    echo "Refusing to remove dirty worktree $WT_DIR; commit/stash changes or use wt close --force '$BRANCH'." >&2
    return 1
  fi

  # Match the window by its pane cwd, not the colliding display slug.
  local WINDOW=''
  WINDOW="$(tmux list-windows -t "$SESSION" -F '#I	#{pane_current_path}' 2>/dev/null \
    | awk -F '\t' -v path="$WT_DIR" '$2 == path { print $1; exit }' || true)"
  if [ -n "$WINDOW" ]; then
    tmux kill-window -t "$SESSION:$WINDOW"
    echo "tmux window '$SAFE_BRANCH' killed."
  else
    echo "No tmux window for $WT_DIR."
  fi

  # Remove the worktree.
  if [ "$FORCE" = true ]; then
    git -C "$ROOT" worktree remove "$WT_DIR" --force
  else
    git -C "$ROOT" worktree remove "$WT_DIR"
  fi
  echo "Worktree $WT_DIR removed."
}

show_help() {
  sed -n '2,/^set -e/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set -e/d'
}

case "${1:-}" in
  list|ls)      cmd_list ;;
  status|st)    cmd_status ;;
  close|rm)     shift; cmd_close "$@" ;;
  -h|--help|"") show_help ;;
  *)            cmd_new "$@" ;;
esac
